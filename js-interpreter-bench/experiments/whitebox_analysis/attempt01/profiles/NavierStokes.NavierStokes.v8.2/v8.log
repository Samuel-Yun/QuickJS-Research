script-source,5,/mnt/c/Users/mzyx/Desktop/0921/js-interpreter-bench/experiments/whitebox_analysis/attempt01/profiles/NavierStokes.NavierStokes.N32.original.js,// Copyright 2013 the V8 project authors. All rights reserved.\x0d\n// Redistribution and use in source and binary forms\x2C with or without\x0d\n// modification\x2C are permitted provided that the following conditions are\x0d\n// met:\x0d\n//\x0d\n//     * Redistributions of source code must retain the above copyright\x0d\n//       notice\x2C this list of conditions and the following disclaimer.\x0d\n//     * Redistributions in binary form must reproduce the above\x0d\n//       copyright notice\x2C this list of conditions and the following\x0d\n//       disclaimer in the documentation and/or other materials provided\x0d\n//       with the distribution.\x0d\n//     * Neither the name of Google Inc. nor the names of its\x0d\n//       contributors may be used to endorse or promote products derived\x0d\n//       from this software without specific prior written permission.\x0d\n//\x0d\n// THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS\x0d\n// "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES\x2C INCLUDING\x2C BUT NOT\x0d\n// LIMITED TO\x2C THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR\x0d\n// A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT\x0d\n// OWNER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT\x2C INDIRECT\x2C INCIDENTAL\x2C\x0d\n// SPECIAL\x2C EXEMPLARY\x2C OR CONSEQUENTIAL DAMAGES (INCLUDING\x2C BUT NOT\x0d\n// LIMITED TO\x2C PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE\x2C\x0d\n// DATA\x2C OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY\x0d\n// THEORY OF LIABILITY\x2C WHETHER IN CONTRACT\x2C STRICT LIABILITY\x2C OR TORT\x0d\n// (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE\x0d\n// OF THIS SOFTWARE\x2C EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\x0d\n\x0d\n\x0d\n// Performance.now is used in latency benchmarks\x2C the fallback is Date.now.\x0d\nvar performance = performance || {};\x0d\nperformance.now = (function() {\x0d\n  return performance.now       ||\x0d\n         performance.mozNow    ||\x0d\n         performance.msNow     ||\x0d\n         performance.oNow      ||\x0d\n         performance.webkitNow ||\x0d\n         Date.now;\x0d\n})();\x0d\n\x0d\n// Simple framework for running the benchmark suites and\x0d\n// computing a score based on the timing measurements.\x0d\n\x0d\n\x0d\n// A benchmark has a name (string) and a function that will be run to\x0d\n// do the performance measurement. The optional setup and tearDown\x0d\n// arguments are functions that will be invoked before and after\x0d\n// running the benchmark\x2C but the running time of these functions will\x0d\n// not be accounted for in the benchmark score.\x0d\nfunction Benchmark(name\x2C doWarmup\x2C doDeterministic\x2C deterministicIterations\x2C \x0d\n                   run\x2C setup\x2C tearDown\x2C rmsResult\x2C minIterations) {\x0d\n  this.name = name;\x0d\n  this.doWarmup = doWarmup;\x0d\n  this.doDeterministic = doDeterministic;\x0d\n  this.deterministicIterations = deterministicIterations;\x0d\n  this.run = run;\x0d\n  this.Setup = setup ? setup : function() { };\x0d\n  this.TearDown = tearDown ? tearDown : function() { };\x0d\n  this.rmsResult = rmsResult ? rmsResult : null; \x0d\n  this.minIterations = minIterations ? minIterations : 32;\x0d\n}\x0d\n\x0d\n\x0d\n// Benchmark results hold the benchmark and the measured time used to\x0d\n// run the benchmark. The benchmark score is computed later once a\x0d\n// full benchmark suite has run to completion. If latency is set to 0\x0d\n// then there is no latency score for this benchmark.\x0d\nfunction BenchmarkResult(benchmark\x2C time\x2C latency) {\x0d\n  this.benchmark = benchmark;\x0d\n  this.time = time;\x0d\n  this.latency = latency;\x0d\n}\x0d\n\x0d\n\x0d\n// Automatically convert results to numbers. Used by the geometric\x0d\n// mean computation.\x0d\nBenchmarkResult.prototype.valueOf = function() {\x0d\n  return this.time;\x0d\n}\x0d\n\x0d\n\x0d\n// Suites of benchmarks consist of a name and the set of benchmarks in\x0d\n// addition to the reference timing that the final score will be based\x0d\n// on. This way\x2C all scores are relative to a reference run and higher\x0d\n// scores implies better performance.\x0d\nfunction BenchmarkSuite(name\x2C reference\x2C benchmarks) {\x0d\n  this.name = name;\x0d\n  this.reference = reference;\x0d\n  this.benchmarks = benchmarks;\x0d\n  BenchmarkSuite.suites.push(this);\x0d\n}\x0d\n\x0d\n\x0d\n// Keep track of all declared benchmark suites.\x0d\nBenchmarkSuite.suites = [];\x0d\n\x0d\n// Scores are not comparable across versions. Bump the version if\x0d\n// you're making changes that will affect that scores\x2C e.g. if you add\x0d\n// a new benchmark or change an existing one.\x0d\nBenchmarkSuite.version = '9';\x0d\n\x0d\n\x0d\n// Defines global benchsuite running mode that overrides benchmark suite \x0d\n// behavior. Intended to be set by the benchmark driver. Undefined \x0d\n// values here allow a benchmark to define behaviour itself.\x0d\nBenchmarkSuite.config = {\x0d\n  doWarmup: undefined\x2C\x0d\n  doDeterministic: undefined\x0d\n};\x0d\n\x0d\n\x0d\n// Override the alert function to throw an exception instead.\x0d\nalert = function(s) {\x0d\n  throw "Alert called with argument: " + s;\x0d\n};\x0d\n\x0d\n\x0d\n// To make the benchmark results predictable\x2C we replace Math.random\x0d\n// with a 100% deterministic alternative.\x0d\nBenchmarkSuite.ResetRNG = function() {\x0d\n  Math.random = (function() {\x0d\n    var seed = 49734321;\x0d\n    return function() {\x0d\n      // Robert Jenkins' 32 bit integer hash function.\x0d\n      seed = ((seed + 0x7ed55d16) + (seed << 12))  & 0xffffffff;\x0d\n      seed = ((seed ^ 0xc761c23c) ^ (seed >>> 19)) & 0xffffffff;\x0d\n      seed = ((seed + 0x165667b1) + (seed << 5))   & 0xffffffff;\x0d\n      seed = ((seed + 0xd3a2646c) ^ (seed << 9))   & 0xffffffff;\x0d\n      seed = ((seed + 0xfd7046c5) + (seed << 3))   & 0xffffffff;\x0d\n      seed = ((seed ^ 0xb55a4f09) ^ (seed >>> 16)) & 0xffffffff;\x0d\n      return (seed & 0xfffffff) / 0x10000000;\x0d\n    };\x0d\n  })();\x0d\n}\x0d\n\x0d\n\x0d\n// Runs all registered benchmark suites and optionally yields between\x0d\n// each individual benchmark to avoid running for too long in the\x0d\n// context of browsers. Once done\x2C the final score is reported to the\x0d\n// runner.\x0d\nBenchmarkSuite.RunSuites = function(runner\x2C skipBenchmarks) {\x0d\n  skipBenchmarks = typeof skipBenchmarks === 'undefined' ? [] : skipBenchmarks;\x0d\n  var continuation = null;\x0d\n  var suites = BenchmarkSuite.suites;\x0d\n  var length = suites.length;\x0d\n  BenchmarkSuite.scores = [];\x0d\n  var index = 0;\x0d\n  function RunStep() {\x0d\n    while (continuation || index < length) {\x0d\n      if (continuation) {\x0d\n        continuation = continuation();\x0d\n      } else {\x0d\n        var suite = suites[index++];\x0d\n        if (runner.NotifyStart) runner.NotifyStart(suite.name);\x0d\n        if (skipBenchmarks.indexOf(suite.name) > -1) {\x0d\n          suite.NotifySkipped(runner);\x0d\n        } else {\x0d\n          continuation = suite.RunStep(runner);\x0d\n        }\x0d\n      }\x0d\n      if (continuation && typeof window != 'undefined' && window.setTimeout) {\x0d\n        window.setTimeout(RunStep\x2C 25);\x0d\n        return;\x0d\n      }\x0d\n    }\x0d\n\x0d\n    // show final result\x0d\n    if (runner.NotifyScore) {\x0d\n      var score = BenchmarkSuite.GeometricMean(BenchmarkSuite.scores);\x0d\n      var formatted = BenchmarkSuite.FormatScore(100 * score);\x0d\n      runner.NotifyScore(formatted);\x0d\n    }\x0d\n  }\x0d\n  RunStep();\x0d\n}\x0d\n\x0d\n\x0d\n// Counts the total number of registered benchmarks. Useful for\x0d\n// showing progress as a percentage.\x0d\nBenchmarkSuite.CountBenchmarks = function() {\x0d\n  var result = 0;\x0d\n  var suites = BenchmarkSuite.suites;\x0d\n  for (var i = 0; i < suites.length; i++) {\x0d\n    result += suites[i].benchmarks.length;\x0d\n  }\x0d\n  return result;\x0d\n}\x0d\n\x0d\n\x0d\n// Computes the geometric mean of a set of numbers.\x0d\nBenchmarkSuite.GeometricMean = function(numbers) {\x0d\n  var log = 0;\x0d\n  for (var i = 0; i < numbers.length; i++) {\x0d\n    log += Math.log(numbers[i]);\x0d\n  }\x0d\n  return Math.pow(Math.E\x2C log / numbers.length);\x0d\n}\x0d\n\x0d\n\x0d\n// Computes the geometric mean of a set of throughput time measurements.\x0d\nBenchmarkSuite.GeometricMeanTime = function(measurements) {\x0d\n  var log = 0;\x0d\n  for (var i = 0; i < measurements.length; i++) {\x0d\n    log += Math.log(measurements[i].time);\x0d\n  }\x0d\n  return Math.pow(Math.E\x2C log / measurements.length);\x0d\n}\x0d\n\x0d\n\x0d\n// Computes the geometric mean of a set of rms measurements.\x0d\nBenchmarkSuite.GeometricMeanLatency = function(measurements) {\x0d\n  var log = 0;\x0d\n  var hasLatencyResult = false;\x0d\n  for (var i = 0; i < measurements.length; i++) {\x0d\n    if (measurements[i].latency != 0) {\x0d\n      log += Math.log(measurements[i].latency);\x0d\n      hasLatencyResult = true;\x0d\n    }\x0d\n  }\x0d\n  if (hasLatencyResult) {\x0d\n    return Math.pow(Math.E\x2C log / measurements.length);\x0d\n  } else {\x0d\n    return 0;\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\n// Converts a score value to a string with at least three significant\x0d\n// digits.\x0d\nBenchmarkSuite.FormatScore = function(value) {\x0d\n  if (value > 100) {\x0d\n    return value.toFixed(0);\x0d\n  } else {\x0d\n    return value.toPrecision(3);\x0d\n  }\x0d\n}\x0d\n\x0d\n// Notifies the runner that we're done running a single benchmark in\x0d\n// the benchmark suite. This can be useful to report progress.\x0d\nBenchmarkSuite.prototype.NotifyStep = function(result) {\x0d\n  this.results.push(result);\x0d\n  if (this.runner.NotifyStep) this.runner.NotifyStep(result.benchmark.name);\x0d\n}\x0d\n\x0d\n\x0d\n// Notifies the runner that we're done with running a suite and that\x0d\n// we have a result which can be reported to the user if needed.\x0d\nBenchmarkSuite.prototype.NotifyResult = function() {\x0d\n  var mean = BenchmarkSuite.GeometricMeanTime(this.results);\x0d\n  var score = this.reference[0] / mean;\x0d\n  BenchmarkSuite.scores.push(score);\x0d\n  if (this.runner.NotifyResult) {\x0d\n    var formatted = BenchmarkSuite.FormatScore(100 * score);\x0d\n    this.runner.NotifyResult(this.name\x2C formatted);\x0d\n  }\x0d\n  if (this.reference.length == 2) {\x0d\n    var meanLatency = BenchmarkSuite.GeometricMeanLatency(this.results);\x0d\n    if (meanLatency != 0) {\x0d\n      var scoreLatency = this.reference[1] / meanLatency;\x0d\n      BenchmarkSuite.scores.push(scoreLatency);\x0d\n      if (this.runner.NotifyResult) {\x0d\n        var formattedLatency = BenchmarkSuite.FormatScore(100 * scoreLatency)\x0d\n        this.runner.NotifyResult(this.name + "Latency"\x2C formattedLatency);\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\nBenchmarkSuite.prototype.NotifySkipped = function(runner) {\x0d\n  BenchmarkSuite.scores.push(1);  // push default reference score.\x0d\n  if (runner.NotifyResult) {\x0d\n    runner.NotifyResult(this.name\x2C "Skipped");\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\n// Notifies the runner that running a benchmark resulted in an error.\x0d\nBenchmarkSuite.prototype.NotifyError = function(error) {\x0d\n  if (this.runner.NotifyError) {\x0d\n    this.runner.NotifyError(this.name\x2C error);\x0d\n  }\x0d\n  if (this.runner.NotifyStep) {\x0d\n    this.runner.NotifyStep(this.name);\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\n// Runs a single benchmark for at least a second and computes the\x0d\n// average time it takes to run a single iteration.\x0d\nBenchmarkSuite.prototype.RunSingleBenchmark = function(benchmark\x2C data) {\x0d\n  var config = BenchmarkSuite.config;\x0d\n  var doWarmup = config.doWarmup !== undefined \x0d\n                 ? config.doWarmup \x0d\n                 : benchmark.doWarmup;\x0d\n  var doDeterministic = config.doDeterministic !== undefined \x0d\n                        ? config.doDeterministic \x0d\n                        : benchmark.doDeterministic;\x0d\n\x0d\n  function Measure(data) {\x0d\n    var elapsed = 0;\x0d\n    var start = new Date();\x0d\n  \x0d\n  // Run either for 1 second or for the number of iterations specified\x0d\n  // by minIterations\x2C depending on the config flag doDeterministic.\x0d\n    for (var i = 0; (doDeterministic ? \x0d\n      i<benchmark.deterministicIterations : elapsed < 1000); i++) {\x0d\n      benchmark.run();\x0d\n      elapsed = new Date() - start;\x0d\n    }\x0d\n    if (data != null) {\x0d\n      data.runs += i;\x0d\n      data.elapsed += elapsed;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  // Sets up data in order to skip or not the warmup phase.\x0d\n  if (!doWarmup && data == null) {\x0d\n    data = { runs: 0\x2C elapsed: 0 };\x0d\n  }\x0d\n\x0d\n  if (data == null) {\x0d\n    Measure(null);\x0d\n    return { runs: 0\x2C elapsed: 0 };\x0d\n  } else {\x0d\n    Measure(data);\x0d\n    // If we've run too few iterations\x2C we continue for another second.\x0d\n    if (data.runs < benchmark.minIterations) return data;\x0d\n    var usec = (data.elapsed * 1000) / data.runs;\x0d\n    var rms = (benchmark.rmsResult != null) ? benchmark.rmsResult() : 0;\x0d\n    this.NotifyStep(new BenchmarkResult(benchmark\x2C usec\x2C rms));\x0d\n    return null;\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\n// This function starts running a suite\x2C but stops between each\x0d\n// individual benchmark in the suite and returns a continuation\x0d\n// function which can be invoked to run the next benchmark. Once the\x0d\n// last benchmark has been executed\x2C null is returned.\x0d\nBenchmarkSuite.prototype.RunStep = function(runner) {\x0d\n  BenchmarkSuite.ResetRNG();\x0d\n  this.results = [];\x0d\n  this.runner = runner;\x0d\n  var length = this.benchmarks.length;\x0d\n  var index = 0;\x0d\n  var suite = this;\x0d\n  var data;\x0d\n\x0d\n  // Run the setup\x2C the actual benchmark\x2C and the tear down in three\x0d\n  // separate steps to allow the framework to yield between any of the\x0d\n  // steps.\x0d\n\x0d\n  function RunNextSetup() {\x0d\n    if (index < length) {\x0d\n      try {\x0d\n        suite.benchmarks[index].Setup();\x0d\n      } catch (e) {\x0d\n        suite.NotifyError(e);\x0d\n        return null;\x0d\n      }\x0d\n      return RunNextBenchmark;\x0d\n    }\x0d\n    suite.NotifyResult();\x0d\n    return null;\x0d\n  }\x0d\n\x0d\n  function RunNextBenchmark() {\x0d\n    try {\x0d\n      data = suite.RunSingleBenchmark(suite.benchmarks[index]\x2C data);\x0d\n    } catch (e) {\x0d\n      suite.NotifyError(e);\x0d\n      return null;\x0d\n    }\x0d\n    // If data is null\x2C we're done with this benchmark.\x0d\n    return (data == null) ? RunNextTearDown : RunNextBenchmark();\x0d\n  }\x0d\n\x0d\n  function RunNextTearDown() {\x0d\n    try {\x0d\n      suite.benchmarks[index++].TearDown();\x0d\n    } catch (e) {\x0d\n      suite.NotifyError(e);\x0d\n      return null;\x0d\n    }\x0d\n    return RunNextSetup;\x0d\n  }\x0d\n\x0d\n  // Start out running the setup.\x0d\n  return RunNextSetup();\x0d\n}\x0d\n\n;\n/**\x0d\n * Copyright 2013 the V8 project authors. All rights reserved.\x0d\n * Copyright 2009 Oliver Hunt <http://nerget.com>\x0d\n *\x0d\n * Permission is hereby granted\x2C free of charge\x2C to any person\x0d\n * obtaining a copy of this software and associated documentation\x0d\n * files (the "Software")\x2C to deal in the Software without\x0d\n * restriction\x2C including without limitation the rights to use\x2C\x0d\n * copy\x2C modify\x2C merge\x2C publish\x2C distribute\x2C sublicense\x2C and/or sell\x0d\n * copies of the Software\x2C and to permit persons to whom the\x0d\n * Software is furnished to do so\x2C subject to the following\x0d\n * conditions:\x0d\n *\x0d\n * The above copyright notice and this permission notice shall be\x0d\n * included in all copies or substantial portions of the Software.\x0d\n *\x0d\n * THE SOFTWARE IS PROVIDED "AS IS"\x2C WITHOUT WARRANTY OF ANY KIND\x2C\x0d\n * EXPRESS OR IMPLIED\x2C INCLUDING BUT NOT LIMITED TO THE WARRANTIES\x0d\n * OF MERCHANTABILITY\x2C FITNESS FOR A PARTICULAR PURPOSE AND\x0d\n * NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\x0d\n * HOLDERS BE LIABLE FOR ANY CLAIM\x2C DAMAGES OR OTHER LIABILITY\x2C\x0d\n * WHETHER IN AN ACTION OF CONTRACT\x2C TORT OR OTHERWISE\x2C ARISING\x0d\n * FROM\x2C OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR\x0d\n * OTHER DEALINGS IN THE SOFTWARE.\x0d\n *\x0d\n * Update 10/21/2013: fixed loop variables at line 119\x0d\n */\x0d\n\x0d\nvar NavierStokes = new BenchmarkSuite('NavierStokes'\x2C [1484000]\x2C\x0d\n                                      [new Benchmark('NavierStokes'\x2C\x0d\n                                                     true\x2C\x0d\n                                                     false\x2C\x0d\n                                                     180\x2C\x0d\n                                                     runNavierStokes\x2C\x0d\n                                                     setupNavierStokes\x2C\x0d\n                                                     tearDownNavierStokes\x2C\x0d\n                                                     null\x2C\x0d\n                                                     16)]);\x0d\n\x0d\nvar solver = null;\x0d\nvar nsFrameCounter = 0;\x0d\n\x0d\nfunction runNavierStokes()\x0d\n{\x0d\n    solver.update();\x0d\n    nsFrameCounter++;\x0d\n\x0d\n    if(nsFrameCounter==15)\x0d\n        checkResult(solver.getDens());\x0d\n}\x0d\n\x0d\nfunction checkResult(dens) {\x0d\n\x0d\n    this.result = 0;\x0d\n    for (var i=7000;i<7100;i++) {\x0d\n        this.result+=~~((dens[i]*10));\x0d\n    }\x0d\n\x0d\n    if (this.result!=77) {\x0d\n        throw(new Error("checksum failed"));\x0d\n    }\x0d\n}\x0d\n\x0d\nfunction setupNavierStokes()\x0d\n{\x0d\n    solver = new FluidField(null);\x0d\n    solver.setResolution(128\x2C 128);\x0d\n    solver.setIterations(20);\x0d\n    solver.setDisplayFunction(function(){});\x0d\n    solver.setUICallback(prepareFrame);\x0d\n    solver.reset();\x0d\n}\x0d\n\x0d\nfunction tearDownNavierStokes()\x0d\n{\x0d\n    solver = null;\x0d\n}\x0d\n\x0d\nfunction addPoints(field) {\x0d\n    var n = 64;\x0d\n    for (var i = 1; i <= n; i++) {\x0d\n        field.setVelocity(i\x2C i\x2C n\x2C n);\x0d\n        field.setDensity(i\x2C i\x2C 5);\x0d\n        field.setVelocity(i\x2C n - i\x2C -n\x2C -n);\x0d\n        field.setDensity(i\x2C n - i\x2C 20);\x0d\n        field.setVelocity(128 - i\x2C n + i\x2C -n\x2C -n);\x0d\n        field.setDensity(128 - i\x2C n + i\x2C 30);\x0d\n    }\x0d\n}\x0d\n\x0d\nvar framesTillAddingPoints = 0;\x0d\nvar framesBetweenAddingPoints = 5;\x0d\n\x0d\nfunction prepareFrame(field)\x0d\n{\x0d\n    if (framesTillAddingPoints == 0) {\x0d\n        addPoints(field);\x0d\n        framesTillAddingPoints = framesBetweenAddingPoints;\x0d\n        framesBetweenAddingPoints++;\x0d\n    } else {\x0d\n        framesTillAddingPoints--;\x0d\n    }\x0d\n}\x0d\n\x0d\n// Code from Oliver Hunt (http://nerget.com/fluidSim/pressure.js) starts here.\x0d\nfunction FluidField(canvas) {\x0d\n    function addFields(x\x2C s\x2C dt)\x0d\n    {\x0d\n        for (var i=0; i<size ; i++ ) x[i] += dt*s[i];\x0d\n    }\x0d\n\x0d\n    function set_bnd(b\x2C x)\x0d\n    {\x0d\n        if (b===1) {\x0d\n            for (var i = 1; i <= width; i++) {\x0d\n                x[i] =  x[i + rowSize];\x0d\n                x[i + (height+1) *rowSize] = x[i + height * rowSize];\x0d\n            }\x0d\n\x0d\n            for (var j = 1; j <= height; j++) {\x0d\n                x[j * rowSize] = -x[1 + j * rowSize];\x0d\n                x[(width + 1) + j * rowSize] = -x[width + j * rowSize];\x0d\n            }\x0d\n        } else if (b === 2) {\x0d\n            for (var i = 1; i <= width; i++) {\x0d\n                x[i] = -x[i + rowSize];\x0d\n                x[i + (height + 1) * rowSize] = -x[i + height * rowSize];\x0d\n            }\x0d\n\x0d\n            for (var j = 1; j <= height; j++) {\x0d\n                x[j * rowSize] =  x[1 + j * rowSize];\x0d\n                x[(width + 1) + j * rowSize] =  x[width + j * rowSize];\x0d\n            }\x0d\n        } else {\x0d\n            for (var i = 1; i <= width; i++) {\x0d\n                x[i] =  x[i + rowSize];\x0d\n                x[i + (height + 1) * rowSize] = x[i + height * rowSize];\x0d\n            }\x0d\n\x0d\n            for (var j = 1; j <= height; j++) {\x0d\n                x[j * rowSize] =  x[1 + j * rowSize];\x0d\n                x[(width + 1) + j * rowSize] =  x[width + j * rowSize];\x0d\n            }\x0d\n        }\x0d\n        var maxEdge = (height + 1) * rowSize;\x0d\n        x[0]                 = 0.5 * (x[1] + x[rowSize]);\x0d\n        x[maxEdge]           = 0.5 * (x[1 + maxEdge] + x[height * rowSize]);\x0d\n        x[(width+1)]         = 0.5 * (x[width] + x[(width + 1) + rowSize]);\x0d\n        x[(width+1)+maxEdge] = 0.5 * (x[width + maxEdge] + x[(width + 1) + height * rowSize]);\x0d\n    }\x0d\n\x0d\n    function lin_solve(b\x2C x\x2C x0\x2C a\x2C c)\x0d\n    {\x0d\n        if (a === 0 && c === 1) {\x0d\n            for (var j=1 ; j<=height; j++) {\x0d\n                var currentRow = j * rowSize;\x0d\n                ++currentRow;\x0d\n                for (var i = 0; i < width; i++) {\x0d\n                    x[currentRow] = x0[currentRow];\x0d\n                    ++currentRow;\x0d\n                }\x0d\n            }\x0d\n            set_bnd(b\x2C x);\x0d\n        } else {\x0d\n            var invC = 1 / c;\x0d\n            for (var k=0 ; k<iterations; k++) {\x0d\n                for (var j=1 ; j<=height; j++) {\x0d\n                    var lastRow = (j - 1) * rowSize;\x0d\n                    var currentRow = j * rowSize;\x0d\n                    var nextRow = (j + 1) * rowSize;\x0d\n                    var lastX = x[currentRow];\x0d\n                    ++currentRow;\x0d\n                    for (var i=1; i<=width; i++)\x0d\n                        lastX = x[currentRow] = (x0[currentRow] + a*(lastX+x[++currentRow]+x[++lastRow]+x[++nextRow])) * invC;\x0d\n                }\x0d\n                set_bnd(b\x2C x);\x0d\n            }\x0d\n        }\x0d\n    }\x0d\n\x0d\n    function diffuse(b\x2C x\x2C x0\x2C dt)\x0d\n    {\x0d\n        var a = 0;\x0d\n        lin_solve(b\x2C x\x2C x0\x2C a\x2C 1 + 4*a);\x0d\n    }\x0d\n\x0d\n    function lin_solve2(x\x2C x0\x2C y\x2C y0\x2C a\x2C c)\x0d\n    {\x0d\n        if (a === 0 && c === 1) {\x0d\n            for (var j=1 ; j <= height; j++) {\x0d\n                var currentRow = j * rowSize;\x0d\n                ++currentRow;\x0d\n                for (var i = 0; i < width; i++) {\x0d\n                    x[currentRow] = x0[currentRow];\x0d\n                    y[currentRow] = y0[currentRow];\x0d\n                    ++currentRow;\x0d\n                }\x0d\n            }\x0d\n            set_bnd(1\x2C x);\x0d\n            set_bnd(2\x2C y);\x0d\n        } else {\x0d\n            var invC = 1/c;\x0d\n            for (var k=0 ; k<iterations; k++) {\x0d\n                for (var j=1 ; j <= height; j++) {\x0d\n                    var lastRow = (j - 1) * rowSize;\x0d\n                    var currentRow = j * rowSize;\x0d\n                    var nextRow = (j + 1) * rowSize;\x0d\n                    var lastX = x[currentRow];\x0d\n                    var lastY = y[currentRow];\x0d\n                    ++currentRow;\x0d\n                    for (var i = 1; i <= width; i++) {\x0d\n                        lastX = x[currentRow] = (x0[currentRow] + a * (lastX + x[currentRow] + x[lastRow] + x[nextRow])) * invC;\x0d\n                        lastY = y[currentRow] = (y0[currentRow] + a * (lastY + y[++currentRow] + y[++lastRow] + y[++nextRow])) * invC;\x0d\n                    }\x0d\n                }\x0d\n                set_bnd(1\x2C x);\x0d\n                set_bnd(2\x2C y);\x0d\n            }\x0d\n        }\x0d\n    }\x0d\n\x0d\n    function diffuse2(x\x2C x0\x2C y\x2C y0\x2C dt)\x0d\n    {\x0d\n        var a = 0;\x0d\n        lin_solve2(x\x2C x0\x2C y\x2C y0\x2C a\x2C 1 + 4 * a);\x0d\n    }\x0d\n\x0d\n    function advect(b\x2C d\x2C d0\x2C u\x2C v\x2C dt)\x0d\n    {\x0d\n        var Wdt0 = dt * width;\x0d\n        var Hdt0 = dt * height;\x0d\n        var Wp5 = width + 0.5;\x0d\n        var Hp5 = height + 0.5;\x0d\n        for (var j = 1; j<= height; j++) {\x0d\n            var pos = j * rowSize;\x0d\n            for (var i = 1; i <= width; i++) {\x0d\n                var x = i - Wdt0 * u[++pos];\x0d\n                var y = j - Hdt0 * v[pos];\x0d\n                if (x < 0.5)\x0d\n                    x = 0.5;\x0d\n                else if (x > Wp5)\x0d\n                    x = Wp5;\x0d\n                var i0 = x | 0;\x0d\n                var i1 = i0 + 1;\x0d\n                if (y < 0.5)\x0d\n                    y = 0.5;\x0d\n                else if (y > Hp5)\x0d\n                    y = Hp5;\x0d\n                var j0 = y | 0;\x0d\n                var j1 = j0 + 1;\x0d\n                var s1 = x - i0;\x0d\n                var s0 = 1 - s1;\x0d\n                var t1 = y - j0;\x0d\n                var t0 = 1 - t1;\x0d\n                var row1 = j0 * rowSize;\x0d\n                var row2 = j1 * rowSize;\x0d\n                d[pos] = s0 * (t0 * d0[i0 + row1] + t1 * d0[i0 + row2]) + s1 * (t0 * d0[i1 + row1] + t1 * d0[i1 + row2]);\x0d\n            }\x0d\n        }\x0d\n        set_bnd(b\x2C d);\x0d\n    }\x0d\n\x0d\n    function project(u\x2C v\x2C p\x2C div)\x0d\n    {\x0d\n        var h = -0.5 / Math.sqrt(width * height);\x0d\n        for (var j = 1 ; j <= height; j++ ) {\x0d\n            var row = j * rowSize;\x0d\n            var previousRow = (j - 1) * rowSize;\x0d\n            var prevValue = row - 1;\x0d\n            var currentRow = row;\x0d\n            var nextValue = row + 1;\x0d\n            var nextRow = (j + 1) * rowSize;\x0d\n            for (var i = 1; i <= width; i++ ) {\x0d\n                div[++currentRow] = h * (u[++nextValue] - u[++prevValue] + v[++nextRow] - v[++previousRow]);\x0d\n                p[currentRow] = 0;\x0d\n            }\x0d\n        }\x0d\n        set_bnd(0\x2C div);\x0d\n        set_bnd(0\x2C p);\x0d\n\x0d\n        lin_solve(0\x2C p\x2C div\x2C 1\x2C 4 );\x0d\n        var wScale = 0.5 * width;\x0d\n        var hScale = 0.5 * height;\x0d\n        for (var j = 1; j<= height; j++ ) {\x0d\n            var prevPos = j * rowSize - 1;\x0d\n            var currentPos = j * rowSize;\x0d\n            var nextPos = j * rowSize + 1;\x0d\n            var prevRow = (j - 1) * rowSize;\x0d\n            var currentRow = j * rowSize;\x0d\n            var nextRow = (j + 1) * rowSize;\x0d\n\x0d\n            for (var i = 1; i<= width; i++) {\x0d\n                u[++currentPos] -= wScale * (p[++nextPos] - p[++prevPos]);\x0d\n                v[currentPos]   -= hScale * (p[++nextRow] - p[++prevRow]);\x0d\n            }\x0d\n        }\x0d\n        set_bnd(1\x2C u);\x0d\n        set_bnd(2\x2C v);\x0d\n    }\x0d\n\x0d\n    function dens_step(x\x2C x0\x2C u\x2C v\x2C dt)\x0d\n    {\x0d\n        addFields(x\x2C x0\x2C dt);\x0d\n        diffuse(0\x2C x0\x2C x\x2C dt );\x0d\n        advect(0\x2C x\x2C x0\x2C u\x2C v\x2C dt );\x0d\n    }\x0d\n\x0d\n    function vel_step(u\x2C v\x2C u0\x2C v0\x2C dt)\x0d\n    {\x0d\n        addFields(u\x2C u0\x2C dt );\x0d\n        addFields(v\x2C v0\x2C dt );\x0d\n        var temp = u0; u0 = u; u = temp;\x0d\n        var temp = v0; v0 = v; v = temp;\x0d\n        diffuse2(u\x2Cu0\x2Cv\x2Cv0\x2C dt);\x0d\n        project(u\x2C v\x2C u0\x2C v0);\x0d\n        var temp = u0; u0 = u; u = temp;\x0d\n        var temp = v0; v0 = v; v = temp;\x0d\n        advect(1\x2C u\x2C u0\x2C u0\x2C v0\x2C dt);\x0d\n        advect(2\x2C v\x2C v0\x2C u0\x2C v0\x2C dt);\x0d\n        project(u\x2C v\x2C u0\x2C v0 );\x0d\n    }\x0d\n    var uiCallback = function(d\x2Cu\x2Cv) {};\x0d\n\x0d\n    function Field(dens\x2C u\x2C v) {\x0d\n        // Just exposing the fields here rather than using accessors is a measurable win during display (maybe 5%)\x0d\n        // but makes the code ugly.\x0d\n        this.setDensity = function(x\x2C y\x2C d) {\x0d\n             dens[(x + 1) + (y + 1) * rowSize] = d;\x0d\n        }\x0d\n        this.getDensity = function(x\x2C y) {\x0d\n             return dens[(x + 1) + (y + 1) * rowSize];\x0d\n        }\x0d\n        this.setVelocity = function(x\x2C y\x2C xv\x2C yv) {\x0d\n             u[(x + 1) + (y + 1) * rowSize] = xv;\x0d\n             v[(x + 1) + (y + 1) * rowSize] = yv;\x0d\n        }\x0d\n        this.getXVelocity = function(x\x2C y) {\x0d\n             return u[(x + 1) + (y + 1) * rowSize];\x0d\n        }\x0d\n        this.getYVelocity = function(x\x2C y) {\x0d\n             return v[(x + 1) + (y + 1) * rowSize];\x0d\n        }\x0d\n        this.width = function() { return width; }\x0d\n        this.height = function() { return height; }\x0d\n    }\x0d\n    function queryUI(d\x2C u\x2C v)\x0d\n    {\x0d\n        for (var i = 0; i < size; i++)\x0d\n            u[i] = v[i] = d[i] = 0.0;\x0d\n        uiCallback(new Field(d\x2C u\x2C v));\x0d\n    }\x0d\n\x0d\n    this.update = function () {\x0d\n        queryUI(dens_prev\x2C u_prev\x2C v_prev);\x0d\n        vel_step(u\x2C v\x2C u_prev\x2C v_prev\x2C dt);\x0d\n        dens_step(dens\x2C dens_prev\x2C u\x2C v\x2C dt);\x0d\n        displayFunc(new Field(dens\x2C u\x2C v));\x0d\n    }\x0d\n    this.setDisplayFunction = function(func) {\x0d\n        displayFunc = func;\x0d\n    }\x0d\n\x0d\n    this.iterations = function() { return iterations; }\x0d\n    this.setIterations = function(iters) {\x0d\n        if (iters > 0 && iters <= 100)\x0d\n           iterations = iters;\x0d\n    }\x0d\n    this.setUICallback = function(callback) {\x0d\n        uiCallback = callback;\x0d\n    }\x0d\n    var iterations = 10;\x0d\n    var visc = 0.5;\x0d\n    var dt = 0.1;\x0d\n    var dens;\x0d\n    var dens_prev;\x0d\n    var u;\x0d\n    var u_prev;\x0d\n    var v;\x0d\n    var v_prev;\x0d\n    var width;\x0d\n    var height;\x0d\n    var rowSize;\x0d\n    var size;\x0d\n    var displayFunc;\x0d\n    function reset()\x0d\n    {\x0d\n        rowSize = width + 2;\x0d\n        size = (width+2)*(height+2);\x0d\n        dens = new Array(size);\x0d\n        dens_prev = new Array(size);\x0d\n        u = new Array(size);\x0d\n        u_prev = new Array(size);\x0d\n        v = new Array(size);\x0d\n        v_prev = new Array(size);\x0d\n        for (var i = 0; i < size; i++)\x0d\n            dens_prev[i] = u_prev[i] = v_prev[i] = dens[i] = u[i] = v[i] = 0;\x0d\n    }\x0d\n    this.reset = reset;\x0d\n    this.getDens = function()\x0d\n    {\x0d\n        return dens;\x0d\n    }\x0d\n    this.setResolution = function (hRes\x2C wRes)\x0d\n    {\x0d\n        var res = wRes * hRes;\x0d\n        if (res > 0 && res < 1000000 && (wRes != width || hRes != height)) {\x0d\n            width = wRes;\x0d\n            height = hRes;\x0d\n            reset();\x0d\n            return true;\x0d\n        }\x0d\n        return false;\x0d\n    }\x0d\n    this.setResolution(64\x2C 64);\x0d\n}\x0d\n\n;\n;(function () {\n  var __tebConfig = {"case":"NavierStokes.NavierStokes"\x2C"N":32\x2C"phase":"measure"}\x2C __tebSuite = BenchmarkSuite.suites[0];\n  if (BenchmarkSuite.suites.length !== 1 || __tebSuite.name !== "NavierStokes")\n    throw new Error('suite registration mismatch');\n  var __tebTest = __tebSuite.benchmarks[0];\n  if (__tebTest.name !== "NavierStokes") throw new Error('benchmark registration mismatch');\n  var __tebN = __tebConfig.N\x2C __tebIndex\x2C __tebElapsed = null;\n  var __tebStarted = null\x2C __tebStopped = null;\n  BenchmarkSuite.ResetRNG();\n  if (__tebSuite.name === 'RegExp') {\n    // Frozen strict adaptation: required input construction\x2C omit priming Run.\n    regExpBenchmark = new RegExpBenchmark();\n  } else { __tebTest.Setup(); }\n  if (__tebSuite.name === 'Crypto' && __tebTest.name === 'Decrypt') encrypt();\n  if (__tebConfig.phase === 'correctness') {\n    for (__tebIndex = 0; __tebIndex < __tebN; ++__tebIndex) {\n      __tebTest.run();\n      if (__tebSuite.name === 'Crypto' && __tebTest.name === 'Encrypt') decrypt();\n    }\n  } else {\n    __tebStarted = benchNow();\n    for (__tebIndex = 0; __tebIndex < __tebN; ++__tebIndex) __tebTest.run();\n    __tebStopped = benchNow();\n    __tebElapsed = __tebStopped - __tebStarted;\n  }\n  var __tebExtraCalls = 0;\n  if (__tebSuite.name === 'Crypto' && __tebTest.name === 'Encrypt' && __tebConfig.phase !== 'correctness') decrypt();\n  if (__tebSuite.name === 'NavierStokes') {\n    while (nsFrameCounter < 15) { __tebTest.run(); ++__tebExtraCalls; }\n  }\n  __tebTest.TearDown();\n  if (__tebElapsed !== null && (!Number.isFinite(__tebElapsed) || __tebElapsed < 0))\n    throw new Error('invalid monotonic interval');\n  console.log('TEB_RESULT:' + JSON.stringify({\n    benchmark: 'Octane'\x2C case: __tebConfig.case\x2C suite: __tebSuite.name\x2C\n    subbenchmark: __tebTest.name\x2C mode: 'MAIN_MONOTONIC_V1'\x2C phase: __tebConfig.phase\x2C N: __tebN\x2C\n    correctness: 'PASS'\x2C extra_validation_calls: __tebExtraCalls\x2C checksum: null\x2C\n    timer: 'benchNow'\x2C start_ms: __tebStarted\x2C stop_ms: __tebStopped\x2C elapsed_ms: __tebElapsed\x2C\n    elapsed_per_call_ms: __tebElapsed === null ? null : __tebElapsed / __tebN\x2C warmup_calls: 0\n  }));\n})();\n
