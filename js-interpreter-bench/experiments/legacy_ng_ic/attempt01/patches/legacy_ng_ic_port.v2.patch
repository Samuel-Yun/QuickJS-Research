+static force_inline uint32_t get_index_hash(JSAtom atom, int hash_bits)
+{
+    return (atom * 0x9e370001) >> (32 - hash_bits);
+}
+
+static void emit_ic(JSParseState *s, JSAtom atom)
+{
+    uint32_t h;
+    JSContext *ctx;
+    JSInlineCache *ic;
+    JSInlineCacheHashSlot *ch;
+
+    ic = s->cur_func->ic;
+    if (!ic) return;
+    ctx = s->ctx;
+    if (ic->count + 1 >= ic->capacity && resize_ic_hash(ctx, ic)) {
+        s->cur_func->byte_code.error = 1;
+        return;
+    }
+    h = get_index_hash(atom, ic->hash_bits);
+    for (ch = ic->hash[h]; ch != NULL; ch = ch->next)
+        if (ch->atom == atom)
+            return;
+    ch = js_malloc(ctx, sizeof(*ch));
+    if (unlikely(!ch)) { s->cur_func->byte_code.error = 1; return; }
+    ch->atom = JS_DupAtom(ctx, atom);
+    ch->index = 0;
+    ch->next = ic->hash[h];
+    ic->hash[h] = ch;
+    ic->count += 1;
+}
+
+static void register_ic_operand(JSParseState *s, uint32_t atom)
+{
+    JSFunctionDef *fd = s->cur_func;
+    if (fd->last_opcode_pos >= 0 &&
+        fd->byte_code.size == fd->last_opcode_pos + 1) {
+        int op = fd->byte_code.buf[fd->last_opcode_pos];
+        if (op == OP_get_field || op == OP_get_field2 || op == OP_put_field ||
+            op == OP_get_field_opt_chain)
+            emit_ic(s, atom);
+    }
+}
