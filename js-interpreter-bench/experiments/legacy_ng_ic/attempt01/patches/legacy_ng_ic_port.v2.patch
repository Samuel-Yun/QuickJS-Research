+    JSInlineCache *ic = icu->ic;
+    JSInlineCacheRingSlot *cr;
+    JSShape *shape_slot;
+    assert(cache_offset < ic->capacity);
+    cr = ic->cache + cache_offset;
+    i = cr->index;
+    for (;;) {
+        shape_slot = *(cr->shape + i);
+        if (likely(shape_slot == shape)) {
+            cr->index = i;
+            return cr->prop_offset[i];
