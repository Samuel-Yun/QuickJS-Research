+/* The miss body below retains upstream GET_FIELD_INLINE's normal search. */
+#define GET_READ_IC(name, keep)                                          \
+    {                                                                   \
+        uint32_t index = get_u32(pc), offset;                            \
+        ReadICSite *site = &b->read_ic_sites[index];                     \
+        JSValue obj = sp[-1], val;                                      \
+        JSAtom atom;                                                    \
+        JSObject *p, *origin;                                           \
+        JSProperty *pr;                                                 \
+        JSShapeProperty *prs;                                           \
+        RDI_DLOCAL(index);                                              \
+        pc += 4;                                                        \
+        RDI_QUERY();                                                    \
+        if (likely(JS_VALUE_GET_TAG(obj) == JS_TAG_OBJECT)) {            \
+            p = JS_VALUE_GET_OBJ(obj);                                  \
+            if (p->class_id == JS_CLASS_OBJECT && !p->is_exotic) {        \
+                offset = rdi_probe(site, p->shape RDI_DARG(d));           \
+                if (offset != UINT32_MAX) {                             \
+                    RDI_COUNT(hits);                                   \
+                    val = JS_DupValue(ctx, p->prop[offset].u.value);     \
+                    goto name ## _done;                                \
+                }                                                       \
+                RDI_COUNT(shape_misses);                               \
+            }                                                           \
+        }                                                               \
+        RDI_COUNT(fallback);                                            \
+        atom = site->atom;                                              \
+        if (likely(JS_VALUE_GET_TAG(obj) == JS_TAG_OBJECT)) {            \
+            p = origin = JS_VALUE_GET_OBJ(obj);                         \
+            for (;;) {                                                  \
+                prs = find_own_property(&pr, p, atom);                   \
+                if (prs) {                                              \
+                    if (unlikely(prs->flags & JS_PROP_TMASK)) {          \
+                        RDI_REASON(descriptor);                        \
+                        goto name ## _slow;                            \
+                    }                                                   \
+                    val = JS_DupValue(ctx, pr->u.value);                \
+                    if (p != origin) { RDI_REASON(inherited); }         \
+                    else if (p->class_id != JS_CLASS_OBJECT || p->is_exotic) { RDI_REASON(special); } \
+                    else if (!p->shape->is_hashed) { RDI_REASON(unhashed); } \
+                    else {                                              \
+                        RDI_REASON(own_miss);                           \
+                        rdi_update(ctx, site, p->shape, pr - p->prop RDI_DARG(d)); \
+                    }                                                   \
+                    break;                                              \
+                }                                                       \
+                if (unlikely(p->is_exotic)) {                           \
+                    RDI_REASON(special);                               \
+                    obj = JS_MKPTR(JS_TAG_OBJECT, p);                   \
+                    goto name ## _slow;                                \
+                }                                                       \
+                p = p->shape->proto;                                    \
+                if (!p) { RDI_REASON(missing); val = JS_UNDEFINED; break; } \
+            }                                                           \
+        } else {                                                        \
+            RDI_REASON(primitive);                                     \
+        name ## _slow:                                                  \
+            sf->cur_pc = pc;                                            \
+            val = JS_GetPropertyInternal(ctx, obj, atom, sp[-1], 0);     \
+            if (unlikely(JS_IsException(val))) goto exception;          \
+        }                                                               \
+    name ## _done:                                                      \
+        if (keep) { *sp++ = val; }                                      \
+        else { JS_FreeValue(ctx, sp[-1]); sp[-1] = val; }                \
+    }
+        CASE(OP_get_field_rdi):
+            GET_READ_IC(get_field_rdi, 0);
+            BREAK;
+        CASE(OP_get_field2_rdi):
+            GET_READ_IC(get_field2_rdi, 1);
+            BREAK;
+#undef GET_READ_IC
--- /dev/null
+++ b/read_ic_prepare.inc
@@ -0,0 +1,37 @@
+/* Called only for fully built b, after all compiler passes / atom fixups. */
+static int rdi_prepare(JSContext *ctx, JSFunctionBytecode *b)
+{
+    uint32_t count = 0, index = 0;
+    int pos, op;
+    assert(!b->read_ic_ready && !b->read_ic_sites);
+    b->read_ic_ready = 1;
+#ifdef READ_IC_DIAGNOSTIC
+    rdi_diag_header_init();
+#endif
+    for (pos = 0; pos < b->byte_code_len; pos += short_opcode_info(op).size) {
+        op = b->byte_code_buf[pos];
+        if (op == OP_get_field || op == OP_get_field2) count++;
+    }
+    if (!count) return 0;
+    if (count > SIZE_MAX / sizeof(ReadICSite)) {
+        JS_ThrowOutOfMemory(ctx);
+        return -1;
+    }
+    b->read_ic_sites = js_mallocz(ctx, count * sizeof(ReadICSite));
+    if (!b->read_ic_sites) return -1;
+    b->read_ic_count = count;
+#ifdef READ_IC_DIAGNOSTIC
+    rdi_diag_prepare(ctx, b);
+#endif
+    for (pos = 0; pos < b->byte_code_len; pos += short_opcode_info(op).size) {
+        uint8_t *pc = b->byte_code_buf + pos;
+        op = *pc;
+        if (op == OP_get_field || op == OP_get_field2) {
+            b->read_ic_sites[index].atom = get_u32(pc + 1);
+            *pc = (op == OP_get_field) ? OP_get_field_rdi : OP_get_field2_rdi;
+            put_u32(pc + 1, index++);
+        }
+    }
+    assert(index == count);
+    return 0;
+}
