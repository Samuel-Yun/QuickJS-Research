+static void mc_enter(JSContext*ctx,JSFunctionBytecode*b,FourSite*s,JSValueConst callee)
+{
+    if(!mc_site){
+        const char*wanted=getenv("CTOR_PROBE_FUNCTION");
+        const char*name=JS_AtomToCString(ctx,b->func_name);
+        int same=name && wanted && !strcmp(name,wanted);
+        if(name)JS_FreeCString(ctx,name);
+        if(same){
+            assert(b->four_count==1);
+            mc_site=s;mc_function=b;mc_pc=s->pc;mc_argc=s->argc;
+            if(atexit(mc_report))abort();
+        }
+    }
+    mc_active=mc_site==s && mc_function==b;
+    mc_stage=0;
+    if(mc_active){
+        assert(JS_VALUE_GET_TAG(callee)==JS_TAG_OBJECT);
+        if(!mc_first_target)mc_first_target=JS_VALUE_GET_OBJ(callee);
+        mc_phase=mc_first_target!=JS_VALUE_GET_OBJ(callee);
+        mc_calls++;mc_phase_calls[mc_phase]++;
+#ifdef TWICE_POLICY
+        if(mc_phase_calls[mc_phase]<=8)mc_trace_before[mc_phase][mc_phase_calls[mc_phase]-1]=s->identity_misses;
+#endif
+    }
+}
+
+static void mc_finish(FourSite*s)
+{
+#ifdef TWICE_POLICY
+    if(mc_active && mc_phase_calls[mc_phase]<=8)mc_trace_after[mc_phase][mc_phase_calls[mc_phase]-1]=s->identity_misses;
+#endif
+}
