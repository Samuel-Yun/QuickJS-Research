+/* c003: same ordinary miss lookup, outlined; caller owns the receiver. */
+static no_inline JSValue rdi_miss_get(JSContext *ctx, ReadICSite *site,
+                                     JSValueConst receiver RDI_DPARAM)
+{
+    JSValueConst obj = receiver;
+    JSValue val;
+    JSObject *p, *origin;
+    JSProperty *pr;
+    JSShapeProperty *prs;
+    JSAtom atom = site->atom;
+    RDI_COUNT(fallback);
+    if (likely(JS_VALUE_GET_TAG(obj) == JS_TAG_OBJECT)) {
+        p = origin = JS_VALUE_GET_OBJ(obj);
+        for (;;) {
+            prs = find_own_property(&pr, p, atom);
+            if (prs) {
+                if (unlikely(prs->flags & JS_PROP_TMASK)) {
+                    RDI_REASON(descriptor);
+                    goto slow;
+                }
+                val = JS_DupValue(ctx, pr->u.value);
+                if (p != origin) { RDI_REASON(inherited); }
+                else if (p->class_id != JS_CLASS_OBJECT || p->is_exotic) { RDI_REASON(special); }
+                else if (!p->shape->is_hashed) { RDI_REASON(unhashed); }
+                else {
+                    RDI_REASON(own_miss);
+                    rdi_update(ctx, site, p->shape, pr - p->prop RDI_DARG(d));
+                }
+                return val;
+            }
+            if (unlikely(p->is_exotic)) {
+                RDI_REASON(special);
+                obj = JS_MKPTR(JS_TAG_OBJECT, p);
+                goto slow;
+            }
+            p = p->shape->proto;
+            if (!p) { RDI_REASON(missing); return JS_UNDEFINED; }
+        }
+    } else { RDI_REASON(primitive); }
+slow:
+    return JS_GetPropertyInternal(ctx, obj, atom, receiver, 0);
+}
