+static void v6_proto_update(JSContext *ctx, ReadICSite *s, JSShape *receiver,
+                            JSShape *holder, uint32_t offset)
+{
+    JSShape *old = s->shape, *old_holder = s->holder_shape;
+    js_dup_shape(receiver);
