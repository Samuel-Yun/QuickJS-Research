-    if (!JS_IsFunction(ctx, argv[0]))
-        return JS_ThrowTypeError(ctx, "expecting function");
-    JS_FreeValue(ctx, agent->broadcast_func);
-    agent->broadcast_func = JS_DupValue(ctx, argv[0]);
-    return JS_UNDEFINED;
-}
