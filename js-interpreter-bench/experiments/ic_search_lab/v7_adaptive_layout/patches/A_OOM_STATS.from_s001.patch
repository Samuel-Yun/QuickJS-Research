-        ci = &tab[code];
-
-        p = get_field(line, 4);
-        if (p) {
-            /* locale dependent casing */
-            while (isspace(*p))
-                p++;
-            if (*p != '#' && *p != '\0')
-                continue;
-        }
-
-
-        p = get_field(line, 1);
-        if (p && *p != ';') {
