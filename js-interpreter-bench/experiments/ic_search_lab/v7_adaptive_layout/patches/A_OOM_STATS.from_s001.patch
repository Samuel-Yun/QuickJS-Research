-int skip_comments(const char *str, int line, int *pline)
-{
-    const char *p;
-    int c;
-
-    p = str;
-    while ((c = (unsigned char)*p++) != '\0') {
-        if (isspace(c)) {
-            if (c == '\n')
-                line++;
-            continue;
-        }
-        if (c == '/' && *p == '/') {
-            while (*++p && *p != '\n')
-                continue;
-            continue;
-        }
-        if (c == '/' && *p == '*') {
-            for (p += 1; *p; p++) {
-                if (*p == '\n') {
-                    line++;
-                    continue;
-                }
-                if (*p == '*' && p[1] == '/') {
-                    p += 2;
-                    break;
-                }
-            }
-            continue;
-        }
-        break;
-    }
-    if (pline)
-        *pline = line;
-
-    return p - str;
-}
