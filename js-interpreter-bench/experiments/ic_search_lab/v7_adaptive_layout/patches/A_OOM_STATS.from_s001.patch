-static BOOL is_broadcast_pending(ThreadLocalStorage *tls)
-{
-    struct list_head *el;
-    Test262Agent *agent;
-    list_for_each(el, &tls->agent_list) {
-        agent = list_entry(el, Test262Agent, link);
-        if (agent->broadcast_pending)
