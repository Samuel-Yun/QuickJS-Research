-char *extract_desc(const char *buf, char style)
-{
-    const char *p, *desc_start;
-    char *desc;
-    int len;
-
-    p = buf;
-    while (*p != '\0') {
-        if (p[0] == '/' && p[1] == '*' && p[2] == style && p[3] != '/') {
-            p += 3;
-            desc_start = p;
-            while (*p != '\0' && (p[0] != '*' || p[1] != '/'))
-                p++;
-            if (*p == '\0') {
-                warning("Expecting end of desc comment");
-                return NULL;
-            }
-            len = p - desc_start;
-            desc = malloc(len + 1);
-            memcpy(desc, desc_start, len);
-            desc[len] = '\0';
-            return desc;
-        } else {
-            p++;
-        }
-    }
-    return NULL;
-}
