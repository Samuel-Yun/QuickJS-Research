-            b = 0;
-            b_inv = 0;
-            shift = 0;
-            n0 = 0;
-            rem = 0;
-            while (f != 0) {
-                n = min_int(f, d);
-                if (n != n0) {
-                    b = pow_ui_inv(&b_inv, &shift, radix1, n);
-                    n0 = n;
-                }
-                r = mp_div1norm(a->tab, a->tab, a->len, b, 0, b_inv, shift);
