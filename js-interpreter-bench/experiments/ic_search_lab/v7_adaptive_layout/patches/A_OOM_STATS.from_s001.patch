-    if (!f) {
-        perror_exit(1, filename);
-    }
-    base_name = get_basename(filename);
-
-    while (fgets(buf, sizeof(buf), f) != NULL) {
-        char *p = str_strip(buf);
-        if (*p == '#' || *p == ';' || *p == '\0')
-            continue;  /* line comment */
-
-        namelist_add(lp, base_name, p);
-    }
-    free(base_name);
-    fclose(f);
