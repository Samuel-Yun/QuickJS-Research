-static int ce_cmp(const void *p1, const void *p2)
-{
-    const ComposeEntry *ce1 = p1;
-    const ComposeEntry *ce2 = p2;
-    int i;
-
-    for(i = 0; i < 2; i++) {
-        if (ce1->c[i] < ce2->c[i])
-            return -1;
-        else if (ce1->c[i] > ce2->c[i])
-            return 1;
-    }
-    return 0;
-}
