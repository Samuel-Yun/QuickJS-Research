-                tls->async_done = 2; /* force an error */
-            }
-            if (outfile) {
-                fwrite(str, 1, len, outfile);
-            }
-            JS_FreeCString(ctx, str);
-        } else {
-            if (outfile) {
-                JS_PrintValue(ctx, js_print_value_write, outfile, v, NULL);
-            }
-        }
