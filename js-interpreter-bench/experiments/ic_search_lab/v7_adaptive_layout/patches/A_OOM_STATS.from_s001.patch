-void dump_case_conv_table(FILE *f)
-{
-    int i;
-    uint32_t v;
-    const TableEntry *te;
-
-    total_tables++;
-    total_table_bytes += conv_table_len * sizeof(uint32_t);
-    fprintf(f, "static const uint32_t case_conv_table1[%d] = {", conv_table_len);
