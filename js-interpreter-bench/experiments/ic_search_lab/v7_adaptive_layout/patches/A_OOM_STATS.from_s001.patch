-            for (count = i = 1; i < lp->count; i++) {
-                if (namelist_cmp(lp->array[count - 1], lp->array[i]) == 0) {
-                    free(lp->array[i]);
-                } else {
-                    lp->array[count++] = lp->array[i];
-                }
-            }
-            lp->count = count;
-        }
-    }
