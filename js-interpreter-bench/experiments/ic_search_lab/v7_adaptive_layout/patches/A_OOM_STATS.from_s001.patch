-/* char ranges for various unicode properties */
-
-static int unicode_find_name(const char *name_table, const char *name)
-{
-    const char *p, *r;
-    int pos;
-    size_t name_len, len;
-
-    p = name_table;
-    pos = 0;
-    name_len = strlen(name);
-    while (*p) {
-        for(;;) {
-            r = strchr(p, ',');
-            if (!r)
-                len = strlen(p);
-            else
-                len = r - p;
-            if (len == name_len && !memcmp(p, name, name_len))
-                return pos;
-            p += len + 1;
-            if (!r)
-                break;
-        }
-        pos++;
-    }
-    return -1;
-}
