-static char *get_option(char **pp, int *state)
-{
-    char *p, *p0, *option = NULL;
-    if (*pp) {
-        for (p = *pp;; p++) {
-            switch (*p) {
-            case '[':
-                *state += 1;
-                continue;
-            case ']':
-                *state -= 1;
-                if (*state > 0)
-                    continue;
-                p = NULL;
-                break;
-            case ' ':
-            case '\t':
-            case '\r':
-            case ',':
-            case '-':
-                continue;
-            case '\n':
-                if (*state > 0 || p[1] == ' ')
-                    continue;
-                p = NULL;
-                break;
-            case '\0':
-                p = NULL;
-                break;
-            default:
-                p0 = p;
-                p += strcspn(p0, " \t\r\n,]");
-                option = strdup_len(p0, p - p0);
-                break;
-            }
-            break;
-        }
-        *pp = p;
-    }
-    return option;
-}
