-int longest_match(const char *str, const char *find, int pos, int *ppos, int line, int *pline)
-{
-    int len, maxlen;
-
-    maxlen = 0;
-
-    if (*find) {
-        const char *p;
-        for (p = str + pos; *p; p++) {
-            if (*p == *find) {
-                for (len = 1; p[len] && p[len] == find[len]; len++)
-                    continue;
-                if (len > maxlen) {
-                    maxlen = len;
-                    if (ppos)
-                        *ppos = p - str;
-                    if (pline)
-                        *pline = line;
-                    if (!find[len])
-                        break;
-                }
-            }
-            if (*p == '\n')
-                line++;
-        }
-    }
-    return maxlen;
-}
