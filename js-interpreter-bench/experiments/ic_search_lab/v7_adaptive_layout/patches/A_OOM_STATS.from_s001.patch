-        el = ps->msg_queue.next;
-        msg = list_entry(el, JSWorkerMessage, link);
-
-        /* remove the message from the queue */
-        list_del(&msg->link);
-
-        if (list_empty(&ps->msg_queue))
-            js_waker_clear(&ps->waker);
