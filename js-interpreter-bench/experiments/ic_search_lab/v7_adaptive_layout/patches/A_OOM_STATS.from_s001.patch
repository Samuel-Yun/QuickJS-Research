-void namelist_add(namelist_t *lp, const char *base, const char *name)
-{
-    char *s;
-
-    s = compose_path(base, name);
-    if (!s)
-        goto fail;
-    if (lp->count == lp->size) {
-        size_t newsize = lp->size + (lp->size >> 1) + 4;
-        char **a = realloc(lp->array, sizeof(lp->array[0]) * newsize);
-        if (!a)
-            goto fail;
-        lp->array = a;
-        lp->size = newsize;
-    }
-    lp->array[lp->count] = s;
-    lp->count++;
-    return;
-fail:
-    fatal(1, "allocation failure\n");
-}
