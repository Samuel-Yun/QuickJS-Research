+char *get_line(char *buf, int buf_size, FILE *f)
+{
+    int len;
+    if (!fgets(buf, buf_size, f))
+        return NULL;
+    len = strlen(buf);
+    if (len > 0 && buf[len - 1] == '\n')
+        buf[len - 1] = '\0';
+    return buf;
+}
