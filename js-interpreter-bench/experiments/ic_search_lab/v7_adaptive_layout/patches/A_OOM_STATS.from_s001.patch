-static JSValue js_print(JSContext *ctx, JSValueConst this_val,
-                        int argc, JSValueConst *argv)
-{
-    ThreadLocalStorage *tls = JS_GetRuntimeOpaque(JS_GetRuntime(ctx));
-    int i;
-    JSValueConst v;
-    
-    for (i = 0; i < argc; i++) {
-        if (i != 0 && outfile)
-            fputc(' ', outfile);
