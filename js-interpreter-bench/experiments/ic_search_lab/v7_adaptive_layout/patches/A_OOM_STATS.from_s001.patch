-/* 'cr' must be initialized and empty. Return 0 if OK, -1 if error, -2
-   if not found */
-int unicode_general_category(CharRange *cr, const char *gc_name)
-{
-    int gc_idx;
-    uint32_t gc_mask;
-
-    gc_idx = unicode_find_name(unicode_gc_name_table, gc_name);
