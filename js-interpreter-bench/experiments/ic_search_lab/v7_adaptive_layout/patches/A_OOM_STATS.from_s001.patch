+
+    total_tables++;
+    total_table_bytes += array_len * sizeof(uint16_t);
+    fprintf(f, "static const uint16_t unicode_decomp_table2[%d] = {", array_len);
+    count = 0;
+    for(i = 0; i <= code_max; i++) {
