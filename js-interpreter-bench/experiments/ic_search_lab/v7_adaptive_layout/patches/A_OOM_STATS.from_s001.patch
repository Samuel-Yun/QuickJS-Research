-        return -2;
-    if (gc_idx <= UNICODE_GC_Co) {
-        gc_mask = (uint64_t)1 << gc_idx;
-    } else {
-        gc_mask = unicode_gc_mask_table[gc_idx - UNICODE_GC_LC];
-    }
-    return unicode_general_category1(cr, gc_mask);
-}
