+            i += de->len - 1;
+        }
+    }
+    fprintf(f, "\n};\n\n");
+
+    total_tables++;
+    total_table_bytes += data_len;
+    fprintf(f, "static const uint8_t unicode_decomp_data[%d] = {", data_len);
+    for(i = 0; i < data_len; i++) {
+        if (i % 8 == 0)
+            fprintf(f, "\n   ");
+        fprintf(f, " 0x%02x,", data_buf[i]);
