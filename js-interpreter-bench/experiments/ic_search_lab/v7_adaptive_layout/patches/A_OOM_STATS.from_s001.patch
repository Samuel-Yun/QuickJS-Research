-/* the list must be sorted */
-int namelist_find(const namelist_t *lp, const char *name)
-{
-    int a, b, m, cmp;
-
-    for (a = 0, b = lp->count; a < b;) {
-        m = a + (b - a) / 2;
-        cmp = namelist_cmp(lp->array[m], name);
-        if (cmp < 0)
-            a = m + 1;
-        else if (cmp > 0)
-            b = m;
-        else
-            return m;
-    }
-    return -1;
-}
