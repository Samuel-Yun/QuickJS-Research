-    js_std_add_helpers(ctx, -1, NULL);
-
-    val = JS_LoadModule(ctx, args->basename, args->filename);
-    free(args->filename);
-    free(args->basename);
-    free(args);
-    val = js_std_await(ctx, val);
-    if (JS_IsException(val))
-        js_std_dump_error(ctx);
-    JS_FreeValue(ctx, val);
-
-    js_std_loop(ctx);
-
-    JS_FreeContext(ctx);
-    js_std_free_handlers(rt);
-    JS_FreeRuntime(rt);
-    return NULL;
-}
