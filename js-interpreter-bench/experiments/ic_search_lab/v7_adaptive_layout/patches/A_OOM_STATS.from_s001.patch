-static int get_decomp_pos(const DecompEntry *tab_de, int c)
-{
-    int i, v, k;
-    const DecompEntry *de;
-
-    k = 0;
-    for(i = 0; i <= CHARCODE_MAX; i++) {
-        de = &tab_de[i];
-        if (de->len != 0) {
-            if (c >= de->code && c < de->code + de->len) {
-                v = c - de->code;
-                assert(v < 64);
-                v |= k << 6;
-                assert(v < 65536);
-                return v;
-            }
-            i += de->len - 1;
-            k++;
-        }
-    }
-    return -1;
-}
