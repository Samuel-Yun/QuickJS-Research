+static inline JSValue JS_DupValueRT(JSRuntime *rt, JSValueConst v)
+{
+    if (JS_VALUE_HAS_REF_COUNT(v)) {
+        JSRefCountHeader *p = __js_rc(JS_VALUE_GET_PTR(v));
+        p->ref_count++;
+    }
+    return (JSValue)v;
