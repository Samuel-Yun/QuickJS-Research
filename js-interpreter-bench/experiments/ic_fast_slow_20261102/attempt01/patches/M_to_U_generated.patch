+/* UINT32_MAX remains the miss sentinel; never truncate a large index. */
+static force_inline uint32_t rdi_byte_offset(uint32_t index)
+{
+    if (index > UINT32_MAX / sizeof(JSProperty))
+        return UINT32_MAX;
+    return index * sizeof(JSProperty);
+}
