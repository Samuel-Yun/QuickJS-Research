script-source,3,/home/wssy/workspace/QuickJS-Research/js-interpreter-bench/experiments/ic_microbench_20261109/v8_state01/state.hit0.js,globalThis.scriptArgs = ["own_read.js"\x2C "--hit-percent"\x2C "0"\x2C "--iterations"\x2C "201326592"\x2C "--sequence-length"\x2C "65536"\x2C "--min-ms"\x2C "0"];\n/* Standalone QuickJS microbenchmark. See README.md for the cache model. */\n"use strict";\n\nfunction options(args) {\n    var result = {hitPercent: 100\x2C iterations: 201326592\x2C\n                  sequenceLength: 65536\x2C minMs: 3000\x2C selfTest: false};\n    var names = {"--hit-percent": "hitPercent"\x2C "--iterations": "iterations"\x2C\n                 "--sequence-length": "sequenceLength"\x2C "--min-ms": "minMs"};\n    for (var i = 1; i < args.length; i++) {\n        var arg = args[i];\n        if (arg === "--self-test") { result.selfTest = true; continue; }\n        if (arg === "--help") {\n            print("qjs own_read.js [--hit-percent 0..100] [--iterations N] " +\n                  "[--sequence-length power_of_two] [--min-ms 3000] [--self-test]");\n            return null;\n        }\n        if (!Object.prototype.hasOwnProperty.call(names\x2C arg) || i + 1 >= args.length)\n            throw Error("Unknown or incomplete option: " + arg);\n        var value = Number(args[++i]);\n        if (!Number.isFinite(value)) throw Error("Invalid number for " + arg);\n        result[names[arg]] = value;\n    }\n    if (result.hitPercent < 0 || result.hitPercent > 100)\n        throw Error("hit-percent must be in [0\x2C 100]");\n    // Keep both i and sum=3*N within the signed int32 range for every setting.\n    if (!Number.isInteger(result.iterations) || result.iterations < 1 ||\n        result.iterations > 500000000)\n        throw Error("iterations must be an integer in [1\x2C 500000000]");\n    var length = result.sequenceLength;\n    if (!Number.isInteger(length) || length < 2 || length > 1048576 ||\n        (length & (length - 1)) !== 0)\n        throw Error("sequence-length must be a power of two in [2\x2C 1048576]");\n    if (result.minMs < 0) throw Error("min-ms must be nonnegative");\n    return result;\n}\n\nfunction makeSequence(hitPercent\x2C length) {\n    // x has the same slot and value in both layouts; padding names change shape.\n    // Each layout has two distinct receiver objects with the same shape.\n    var objects = [{x: 3\x2C a: 0}\x2C {x: 3\x2C a: 0}\x2C\n                   {x: 3\x2C b: 0}\x2C {x: 3\x2C b: 0}];\n    var sequence = new Array(length)\x2C shapes = new Uint8Array(length);\n    var half = length / 2;\n    var pairs = Math.round((1 - hitPercent / 100) * half);\n    // A cycle needs an even number of shape changes. Reserve zero for 100%.\n    if (hitPercent < 100 && pairs === 0) pairs = 1;\n    var position = 0;\n    if (pairs === 0) {\n        for (var i = 0; i < length; i++) {\n            shapes[i] = 0;\n            sequence[i] = objects[i & 1];\n        }\n    } else {\n        // Paired equal runs keep the two shapes exactly 50:50 at every rate <100.\n        for (var pair = 0; pair < pairs; pair++) {\n            var run = Math.floor((pair + 1) * half / pairs) -\n                      Math.floor(pair * half / pairs);\n            for (var shape = 0; shape < 2; shape++) {\n                for (var j = 0; j < run; j++) {\n                    shapes[position] = shape;\n                    sequence[position] = objects[shape * 2 + ((position >>> 1) & 1)];\n                    position++;\n                }\n            }\n        }\n        if (position !== length) throw Error("sequence construction failed");\n    }\n    return {sequence: sequence\x2C shapes: shapes\x2C cycleTransitions: pairs * 2};\n}\n\nfunction model(shapes\x2C iterations) {\n    var length = shapes.length\x2C tail = iterations % length;\n    var changes = 0\x2C prefixChanges = 0;\n    for (var i = 1; i < length; i++) {\n        if (shapes[i] !== shapes[i - 1]) {\n            changes++;\n            if (i < tail) prefixChanges++;\n        }\n    }\n    var boundary = shapes[0] !== shapes[length - 1] ? 1 : 0;\n    var transitions = Math.floor(iterations / length) * (changes + boundary) +\n                      prefixChanges - (tail === 0 ? boundary : 0);\n    // Initially empty\x2C one-entry last-shape cache\x2C successful fill on every miss.\n    var misses = transitions + 1;\n    return {hits: iterations - misses\x2C misses: misses\x2C\n            hitPercent: 100 * (iterations - misses) / iterations\x2C\n            cyclicHitPercent: 100 * (1 - (changes + boundary) / length)};\n}\n\n// Exactly one named property-read site in the timed kernel. No RNG\x2C shape\n// construction\x2C rate-dependent branch\x2C counter or clock call inside this loop.\nfunction readLoop(sequence\x2C iterations\x2C mask) {\n    var obj\x2C sum = 0;\n    for (var i = 0; i < iterations; i++) {\n        obj = sequence[i & mask];\n        sum += obj.x;\n    }\n    return sum;\n}\n\nfunction selfTest() {\n    var tests = 0;\n    for (var length of [2\x2C 8\x2C 64]) {\n        for (var rate of [0\x2C 25\x2C 50\x2C 75\x2C 90\x2C 99\x2C 100]) {\n            var data = makeSequence(rate\x2C length)\x2C zeros = 0;\n            for (var shape of data.shapes) if (shape === 0) zeros++;\n            if (rate < 100 && zeros !== length / 2) throw Error("shape balance");\n            for (var n of [1\x2C 2\x2C length - 1\x2C length\x2C length + 1\x2C length * 3 + 5]) {\n                var hits = 0\x2C previous = -1;\n                for (var i = 0; i < n; i++) {\n                    var current = data.shapes[i & (length - 1)];\n                    if (current === previous) hits++;\n                    previous = current;\n                }\n                var expected = model(data.shapes\x2C n);\n                if (hits !== expected.hits || expected.misses !== n - hits)\n                    throw Error("cache-model mismatch");\n                // Use a separate target function so readLoop remains uncalled.\n                var sum = 0;\n                for (var j = 0; j < n; j++) sum += data.sequence[j & (length - 1)].x;\n                if (sum !== 3 * n) throw Error("checksum mismatch");\n                tests++;\n            }\n        }\n    }\n    print(JSON.stringify({kind: "self_test"\x2C status: "PASS"\x2C cases: tests}));\n}\n\nfunction main() {\n    var config = options(scriptArgs);\n    if (config === null) return;\n    if (config.selfTest) { selfTest(); return; }\n    if (typeof performance !== "object" || typeof performance.now !== "function")\n        throw Error("A monotonic performance.now() is required");\n    var data = makeSequence(config.hitPercent\x2C config.sequenceLength);\n    var prediction = model(data.shapes\x2C config.iterations);\n    var mask = config.sequenceLength - 1;\n    var start = performance.now();\n    var checksum = readLoop(data.sequence\x2C config.iterations\x2C mask);\n    var elapsedMs = performance.now() - start;\n    if (checksum !== config.iterations * 3) throw Error("wrong checksum");\n    var durationPass = elapsedMs > config.minMs;\n    print(JSON.stringify({kind: "own_read"\x2C requested_hit_percent: config.hitPercent\x2C\n        iterations: config.iterations\x2C sequence_length: config.sequenceLength\x2C\n        modeled_hits: prediction.hits\x2C modeled_misses: prediction.misses\x2C\n        modeled_hit_percent: prediction.hitPercent\x2C\n        cyclic_hit_percent: prediction.cyclicHitPercent\x2C\n        actual_ic_hit_percent: null\x2C checksum: checksum\x2C elapsed_ms: elapsedMs\x2C\n        ns_per_read_including_loop: elapsedMs * 1e6 / config.iterations\x2C\n        warmup_calls: 0\x2C min_ms: config.minMs\x2C duration_pass: durationPass}));\n    if (!durationPass)\n        throw Error("Timed kernel must exceed " + config.minMs +\n                    " ms; increase --iterations (current " + config.iterations + ")");\n}\n\nmain();\n\n%DebugPrint(readLoop);\n
