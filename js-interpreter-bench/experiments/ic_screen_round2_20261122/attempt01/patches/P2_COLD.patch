+static void cold_mark(JSRuntime*rt,FourSite*s,JS_MarkFunc*mark_func)
+{
+    JS_MarkValue(rt,s->negative,mark_func);
+    FullPlan*p=s->plan;if(!p)return;
+    unsigned n=p->dual?2:1;
+    for(unsigned i=0;i<n;i++){
