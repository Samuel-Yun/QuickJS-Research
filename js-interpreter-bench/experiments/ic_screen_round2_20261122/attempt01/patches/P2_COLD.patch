+static FullPlan*cold_destination(JSContext*ctx,FourSite*slot,JSValueConst callee)
+{
+    FullPlan*p=slot->plan;
+    if(!p || cold_same(p,callee))return p;
+    if(!p->dual){
+        DualPlan*pair;
+#ifdef SCREEN_DIAGNOSTIC
