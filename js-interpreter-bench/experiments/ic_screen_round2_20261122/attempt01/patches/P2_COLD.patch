+        JS_MarkValue(rt,f->callee,mark_func);
+        if(f->initial)mark_func(rt,&f->initial->header);
+        if(f->final)mark_func(rt,&f->final->header);
+    }
+}
+static void cold_free(JSRuntime*rt,FourSite*s)
+{
+    JS_FreeValueRT(rt,s->negative);
