script-source,5,/mnt/c/Users/mzyx/Desktop/0921/js-interpreter-bench/experiments/richards_site_attribution/attempt01/scripts/DIAGNOSTIC_v8_feedback.N32.js,// Copyright 2013 the V8 project authors. All rights reserved.\x0d\n// Redistribution and use in source and binary forms\x2C with or without\x0d\n// modification\x2C are permitted provided that the following conditions are\x0d\n// met:\x0d\n//\x0d\n//     * Redistributions of source code must retain the above copyright\x0d\n//       notice\x2C this list of conditions and the following disclaimer.\x0d\n//     * Redistributions in binary form must reproduce the above\x0d\n//       copyright notice\x2C this list of conditions and the following\x0d\n//       disclaimer in the documentation and/or other materials provided\x0d\n//       with the distribution.\x0d\n//     * Neither the name of Google Inc. nor the names of its\x0d\n//       contributors may be used to endorse or promote products derived\x0d\n//       from this software without specific prior written permission.\x0d\n//\x0d\n// THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS\x0d\n// "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES\x2C INCLUDING\x2C BUT NOT\x0d\n// LIMITED TO\x2C THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR\x0d\n// A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT\x0d\n// OWNER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT\x2C INDIRECT\x2C INCIDENTAL\x2C\x0d\n// SPECIAL\x2C EXEMPLARY\x2C OR CONSEQUENTIAL DAMAGES (INCLUDING\x2C BUT NOT\x0d\n// LIMITED TO\x2C PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE\x2C\x0d\n// DATA\x2C OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY\x0d\n// THEORY OF LIABILITY\x2C WHETHER IN CONTRACT\x2C STRICT LIABILITY\x2C OR TORT\x0d\n// (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE\x0d\n// OF THIS SOFTWARE\x2C EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\x0d\n\x0d\n\x0d\n// Performance.now is used in latency benchmarks\x2C the fallback is Date.now.\x0d\nvar performance = performance || {};\x0d\nperformance.now = (function() {\x0d\n  return performance.now       ||\x0d\n         performance.mozNow    ||\x0d\n         performance.msNow     ||\x0d\n         performance.oNow      ||\x0d\n         performance.webkitNow ||\x0d\n         Date.now;\x0d\n})();\x0d\n\x0d\n// Simple framework for running the benchmark suites and\x0d\n// computing a score based on the timing measurements.\x0d\n\x0d\n\x0d\n// A benchmark has a name (string) and a function that will be run to\x0d\n// do the performance measurement. The optional setup and tearDown\x0d\n// arguments are functions that will be invoked before and after\x0d\n// running the benchmark\x2C but the running time of these functions will\x0d\n// not be accounted for in the benchmark score.\x0d\nfunction Benchmark(name\x2C doWarmup\x2C doDeterministic\x2C deterministicIterations\x2C \x0d\n                   run\x2C setup\x2C tearDown\x2C rmsResult\x2C minIterations) {\x0d\n  this.name = name;\x0d\n  this.doWarmup = doWarmup;\x0d\n  this.doDeterministic = doDeterministic;\x0d\n  this.deterministicIterations = deterministicIterations;\x0d\n  this.run = run;\x0d\n  this.Setup = setup ? setup : function() { };\x0d\n  this.TearDown = tearDown ? tearDown : function() { };\x0d\n  this.rmsResult = rmsResult ? rmsResult : null; \x0d\n  this.minIterations = minIterations ? minIterations : 32;\x0d\n}\x0d\n\x0d\n\x0d\n// Benchmark results hold the benchmark and the measured time used to\x0d\n// run the benchmark. The benchmark score is computed later once a\x0d\n// full benchmark suite has run to completion. If latency is set to 0\x0d\n// then there is no latency score for this benchmark.\x0d\nfunction BenchmarkResult(benchmark\x2C time\x2C latency) {\x0d\n  this.benchmark = benchmark;\x0d\n  this.time = time;\x0d\n  this.latency = latency;\x0d\n}\x0d\n\x0d\n\x0d\n// Automatically convert results to numbers. Used by the geometric\x0d\n// mean computation.\x0d\nBenchmarkResult.prototype.valueOf = function() {\x0d\n  return this.time;\x0d\n}\x0d\n\x0d\n\x0d\n// Suites of benchmarks consist of a name and the set of benchmarks in\x0d\n// addition to the reference timing that the final score will be based\x0d\n// on. This way\x2C all scores are relative to a reference run and higher\x0d\n// scores implies better performance.\x0d\nfunction BenchmarkSuite(name\x2C reference\x2C benchmarks) {\x0d\n  this.name = name;\x0d\n  this.reference = reference;\x0d\n  this.benchmarks = benchmarks;\x0d\n  BenchmarkSuite.suites.push(this);\x0d\n}\x0d\n\x0d\n\x0d\n// Keep track of all declared benchmark suites.\x0d\nBenchmarkSuite.suites = [];\x0d\n\x0d\n// Scores are not comparable across versions. Bump the version if\x0d\n// you're making changes that will affect that scores\x2C e.g. if you add\x0d\n// a new benchmark or change an existing one.\x0d\nBenchmarkSuite.version = '9';\x0d\n\x0d\n\x0d\n// Defines global benchsuite running mode that overrides benchmark suite \x0d\n// behavior. Intended to be set by the benchmark driver. Undefined \x0d\n// values here allow a benchmark to define behaviour itself.\x0d\nBenchmarkSuite.config = {\x0d\n  doWarmup: undefined\x2C\x0d\n  doDeterministic: undefined\x0d\n};\x0d\n\x0d\n\x0d\n// Override the alert function to throw an exception instead.\x0d\nalert = function(s) {\x0d\n  throw "Alert called with argument: " + s;\x0d\n};\x0d\n\x0d\n\x0d\n// To make the benchmark results predictable\x2C we replace Math.random\x0d\n// with a 100% deterministic alternative.\x0d\nBenchmarkSuite.ResetRNG = function() {\x0d\n  Math.random = (function() {\x0d\n    var seed = 49734321;\x0d\n    return function() {\x0d\n      // Robert Jenkins' 32 bit integer hash function.\x0d\n      seed = ((seed + 0x7ed55d16) + (seed << 12))  & 0xffffffff;\x0d\n      seed = ((seed ^ 0xc761c23c) ^ (seed >>> 19)) & 0xffffffff;\x0d\n      seed = ((seed + 0x165667b1) + (seed << 5))   & 0xffffffff;\x0d\n      seed = ((seed + 0xd3a2646c) ^ (seed << 9))   & 0xffffffff;\x0d\n      seed = ((seed + 0xfd7046c5) + (seed << 3))   & 0xffffffff;\x0d\n      seed = ((seed ^ 0xb55a4f09) ^ (seed >>> 16)) & 0xffffffff;\x0d\n      return (seed & 0xfffffff) / 0x10000000;\x0d\n    };\x0d\n  })();\x0d\n}\x0d\n\x0d\n\x0d\n// Runs all registered benchmark suites and optionally yields between\x0d\n// each individual benchmark to avoid running for too long in the\x0d\n// context of browsers. Once done\x2C the final score is reported to the\x0d\n// runner.\x0d\nBenchmarkSuite.RunSuites = function(runner\x2C skipBenchmarks) {\x0d\n  skipBenchmarks = typeof skipBenchmarks === 'undefined' ? [] : skipBenchmarks;\x0d\n  var continuation = null;\x0d\n  var suites = BenchmarkSuite.suites;\x0d\n  var length = suites.length;\x0d\n  BenchmarkSuite.scores = [];\x0d\n  var index = 0;\x0d\n  function RunStep() {\x0d\n    while (continuation || index < length) {\x0d\n      if (continuation) {\x0d\n        continuation = continuation();\x0d\n      } else {\x0d\n        var suite = suites[index++];\x0d\n        if (runner.NotifyStart) runner.NotifyStart(suite.name);\x0d\n        if (skipBenchmarks.indexOf(suite.name) > -1) {\x0d\n          suite.NotifySkipped(runner);\x0d\n        } else {\x0d\n          continuation = suite.RunStep(runner);\x0d\n        }\x0d\n      }\x0d\n      if (continuation && typeof window != 'undefined' && window.setTimeout) {\x0d\n        window.setTimeout(RunStep\x2C 25);\x0d\n        return;\x0d\n      }\x0d\n    }\x0d\n\x0d\n    // show final result\x0d\n    if (runner.NotifyScore) {\x0d\n      var score = BenchmarkSuite.GeometricMean(BenchmarkSuite.scores);\x0d\n      var formatted = BenchmarkSuite.FormatScore(100 * score);\x0d\n      runner.NotifyScore(formatted);\x0d\n    }\x0d\n  }\x0d\n  RunStep();\x0d\n}\x0d\n\x0d\n\x0d\n// Counts the total number of registered benchmarks. Useful for\x0d\n// showing progress as a percentage.\x0d\nBenchmarkSuite.CountBenchmarks = function() {\x0d\n  var result = 0;\x0d\n  var suites = BenchmarkSuite.suites;\x0d\n  for (var i = 0; i < suites.length; i++) {\x0d\n    result += suites[i].benchmarks.length;\x0d\n  }\x0d\n  return result;\x0d\n}\x0d\n\x0d\n\x0d\n// Computes the geometric mean of a set of numbers.\x0d\nBenchmarkSuite.GeometricMean = function(numbers) {\x0d\n  var log = 0;\x0d\n  for (var i = 0; i < numbers.length; i++) {\x0d\n    log += Math.log(numbers[i]);\x0d\n  }\x0d\n  return Math.pow(Math.E\x2C log / numbers.length);\x0d\n}\x0d\n\x0d\n\x0d\n// Computes the geometric mean of a set of throughput time measurements.\x0d\nBenchmarkSuite.GeometricMeanTime = function(measurements) {\x0d\n  var log = 0;\x0d\n  for (var i = 0; i < measurements.length; i++) {\x0d\n    log += Math.log(measurements[i].time);\x0d\n  }\x0d\n  return Math.pow(Math.E\x2C log / measurements.length);\x0d\n}\x0d\n\x0d\n\x0d\n// Computes the geometric mean of a set of rms measurements.\x0d\nBenchmarkSuite.GeometricMeanLatency = function(measurements) {\x0d\n  var log = 0;\x0d\n  var hasLatencyResult = false;\x0d\n  for (var i = 0; i < measurements.length; i++) {\x0d\n    if (measurements[i].latency != 0) {\x0d\n      log += Math.log(measurements[i].latency);\x0d\n      hasLatencyResult = true;\x0d\n    }\x0d\n  }\x0d\n  if (hasLatencyResult) {\x0d\n    return Math.pow(Math.E\x2C log / measurements.length);\x0d\n  } else {\x0d\n    return 0;\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\n// Converts a score value to a string with at least three significant\x0d\n// digits.\x0d\nBenchmarkSuite.FormatScore = function(value) {\x0d\n  if (value > 100) {\x0d\n    return value.toFixed(0);\x0d\n  } else {\x0d\n    return value.toPrecision(3);\x0d\n  }\x0d\n}\x0d\n\x0d\n// Notifies the runner that we're done running a single benchmark in\x0d\n// the benchmark suite. This can be useful to report progress.\x0d\nBenchmarkSuite.prototype.NotifyStep = function(result) {\x0d\n  this.results.push(result);\x0d\n  if (this.runner.NotifyStep) this.runner.NotifyStep(result.benchmark.name);\x0d\n}\x0d\n\x0d\n\x0d\n// Notifies the runner that we're done with running a suite and that\x0d\n// we have a result which can be reported to the user if needed.\x0d\nBenchmarkSuite.prototype.NotifyResult = function() {\x0d\n  var mean = BenchmarkSuite.GeometricMeanTime(this.results);\x0d\n  var score = this.reference[0] / mean;\x0d\n  BenchmarkSuite.scores.push(score);\x0d\n  if (this.runner.NotifyResult) {\x0d\n    var formatted = BenchmarkSuite.FormatScore(100 * score);\x0d\n    this.runner.NotifyResult(this.name\x2C formatted);\x0d\n  }\x0d\n  if (this.reference.length == 2) {\x0d\n    var meanLatency = BenchmarkSuite.GeometricMeanLatency(this.results);\x0d\n    if (meanLatency != 0) {\x0d\n      var scoreLatency = this.reference[1] / meanLatency;\x0d\n      BenchmarkSuite.scores.push(scoreLatency);\x0d\n      if (this.runner.NotifyResult) {\x0d\n        var formattedLatency = BenchmarkSuite.FormatScore(100 * scoreLatency)\x0d\n        this.runner.NotifyResult(this.name + "Latency"\x2C formattedLatency);\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\nBenchmarkSuite.prototype.NotifySkipped = function(runner) {\x0d\n  BenchmarkSuite.scores.push(1);  // push default reference score.\x0d\n  if (runner.NotifyResult) {\x0d\n    runner.NotifyResult(this.name\x2C "Skipped");\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\n// Notifies the runner that running a benchmark resulted in an error.\x0d\nBenchmarkSuite.prototype.NotifyError = function(error) {\x0d\n  if (this.runner.NotifyError) {\x0d\n    this.runner.NotifyError(this.name\x2C error);\x0d\n  }\x0d\n  if (this.runner.NotifyStep) {\x0d\n    this.runner.NotifyStep(this.name);\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\n// Runs a single benchmark for at least a second and computes the\x0d\n// average time it takes to run a single iteration.\x0d\nBenchmarkSuite.prototype.RunSingleBenchmark = function(benchmark\x2C data) {\x0d\n  var config = BenchmarkSuite.config;\x0d\n  var doWarmup = config.doWarmup !== undefined \x0d\n                 ? config.doWarmup \x0d\n                 : benchmark.doWarmup;\x0d\n  var doDeterministic = config.doDeterministic !== undefined \x0d\n                        ? config.doDeterministic \x0d\n                        : benchmark.doDeterministic;\x0d\n\x0d\n  function Measure(data) {\x0d\n    var elapsed = 0;\x0d\n    var start = new Date();\x0d\n  \x0d\n  // Run either for 1 second or for the number of iterations specified\x0d\n  // by minIterations\x2C depending on the config flag doDeterministic.\x0d\n    for (var i = 0; (doDeterministic ? \x0d\n      i<benchmark.deterministicIterations : elapsed < 1000); i++) {\x0d\n      benchmark.run();\x0d\n      elapsed = new Date() - start;\x0d\n    }\x0d\n    if (data != null) {\x0d\n      data.runs += i;\x0d\n      data.elapsed += elapsed;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  // Sets up data in order to skip or not the warmup phase.\x0d\n  if (!doWarmup && data == null) {\x0d\n    data = { runs: 0\x2C elapsed: 0 };\x0d\n  }\x0d\n\x0d\n  if (data == null) {\x0d\n    Measure(null);\x0d\n    return { runs: 0\x2C elapsed: 0 };\x0d\n  } else {\x0d\n    Measure(data);\x0d\n    // If we've run too few iterations\x2C we continue for another second.\x0d\n    if (data.runs < benchmark.minIterations) return data;\x0d\n    var usec = (data.elapsed * 1000) / data.runs;\x0d\n    var rms = (benchmark.rmsResult != null) ? benchmark.rmsResult() : 0;\x0d\n    this.NotifyStep(new BenchmarkResult(benchmark\x2C usec\x2C rms));\x0d\n    return null;\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\n// This function starts running a suite\x2C but stops between each\x0d\n// individual benchmark in the suite and returns a continuation\x0d\n// function which can be invoked to run the next benchmark. Once the\x0d\n// last benchmark has been executed\x2C null is returned.\x0d\nBenchmarkSuite.prototype.RunStep = function(runner) {\x0d\n  BenchmarkSuite.ResetRNG();\x0d\n  this.results = [];\x0d\n  this.runner = runner;\x0d\n  var length = this.benchmarks.length;\x0d\n  var index = 0;\x0d\n  var suite = this;\x0d\n  var data;\x0d\n\x0d\n  // Run the setup\x2C the actual benchmark\x2C and the tear down in three\x0d\n  // separate steps to allow the framework to yield between any of the\x0d\n  // steps.\x0d\n\x0d\n  function RunNextSetup() {\x0d\n    if (index < length) {\x0d\n      try {\x0d\n        suite.benchmarks[index].Setup();\x0d\n      } catch (e) {\x0d\n        suite.NotifyError(e);\x0d\n        return null;\x0d\n      }\x0d\n      return RunNextBenchmark;\x0d\n    }\x0d\n    suite.NotifyResult();\x0d\n    return null;\x0d\n  }\x0d\n\x0d\n  function RunNextBenchmark() {\x0d\n    try {\x0d\n      data = suite.RunSingleBenchmark(suite.benchmarks[index]\x2C data);\x0d\n    } catch (e) {\x0d\n      suite.NotifyError(e);\x0d\n      return null;\x0d\n    }\x0d\n    // If data is null\x2C we're done with this benchmark.\x0d\n    return (data == null) ? RunNextTearDown : RunNextBenchmark();\x0d\n  }\x0d\n\x0d\n  function RunNextTearDown() {\x0d\n    try {\x0d\n      suite.benchmarks[index++].TearDown();\x0d\n    } catch (e) {\x0d\n      suite.NotifyError(e);\x0d\n      return null;\x0d\n    }\x0d\n    return RunNextSetup;\x0d\n  }\x0d\n\x0d\n  // Start out running the setup.\x0d\n  return RunNextSetup();\x0d\n}\x0d\n\n;\n// Copyright 2006-2008 the V8 project authors. All rights reserved.\x0d\n// Redistribution and use in source and binary forms\x2C with or without\x0d\n// modification\x2C are permitted provided that the following conditions are\x0d\n// met:\x0d\n//\x0d\n//     * Redistributions of source code must retain the above copyright\x0d\n//       notice\x2C this list of conditions and the following disclaimer.\x0d\n//     * Redistributions in binary form must reproduce the above\x0d\n//       copyright notice\x2C this list of conditions and the following\x0d\n//       disclaimer in the documentation and/or other materials provided\x0d\n//       with the distribution.\x0d\n//     * Neither the name of Google Inc. nor the names of its\x0d\n//       contributors may be used to endorse or promote products derived\x0d\n//       from this software without specific prior written permission.\x0d\n//\x0d\n// THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS\x0d\n// "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES\x2C INCLUDING\x2C BUT NOT\x0d\n// LIMITED TO\x2C THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR\x0d\n// A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT\x0d\n// OWNER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT\x2C INDIRECT\x2C INCIDENTAL\x2C\x0d\n// SPECIAL\x2C EXEMPLARY\x2C OR CONSEQUENTIAL DAMAGES (INCLUDING\x2C BUT NOT\x0d\n// LIMITED TO\x2C PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE\x2C\x0d\n// DATA\x2C OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY\x0d\n// THEORY OF LIABILITY\x2C WHETHER IN CONTRACT\x2C STRICT LIABILITY\x2C OR TORT\x0d\n// (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE\x0d\n// OF THIS SOFTWARE\x2C EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\x0d\n\x0d\n\x0d\n// This is a JavaScript implementation of the Richards\x0d\n// benchmark from:\x0d\n//\x0d\n//    http://www.cl.cam.ac.uk/~mr10/Bench.html\x0d\n//\x0d\n// The benchmark was originally implemented in BCPL by\x0d\n// Martin Richards.\x0d\n\x0d\n\x0d\nvar Richards = new BenchmarkSuite('Richards'\x2C [35302]\x2C [\x0d\n  new Benchmark("Richards"\x2C true\x2C false\x2C 8200\x2C runRichards)\x0d\n]);\x0d\n\x0d\n\x0d\n/**\x0d\n * The Richards benchmark simulates the task dispatcher of an\x0d\n * operating system.\x0d\n **/\x0d\nfunction runRichards() {\x0d\n  var scheduler = new Scheduler();\x0d\n  scheduler.addIdleTask(ID_IDLE\x2C 0\x2C null\x2C COUNT);\x0d\n\x0d\n  var queue = new Packet(null\x2C ID_WORKER\x2C KIND_WORK);\x0d\n  queue = new Packet(queue\x2C  ID_WORKER\x2C KIND_WORK);\x0d\n  scheduler.addWorkerTask(ID_WORKER\x2C 1000\x2C queue);\x0d\n\x0d\n  queue = new Packet(null\x2C ID_DEVICE_A\x2C KIND_DEVICE);\x0d\n  queue = new Packet(queue\x2C  ID_DEVICE_A\x2C KIND_DEVICE);\x0d\n  queue = new Packet(queue\x2C  ID_DEVICE_A\x2C KIND_DEVICE);\x0d\n  scheduler.addHandlerTask(ID_HANDLER_A\x2C 2000\x2C queue);\x0d\n\x0d\n  queue = new Packet(null\x2C ID_DEVICE_B\x2C KIND_DEVICE);\x0d\n  queue = new Packet(queue\x2C  ID_DEVICE_B\x2C KIND_DEVICE);\x0d\n  queue = new Packet(queue\x2C  ID_DEVICE_B\x2C KIND_DEVICE);\x0d\n  scheduler.addHandlerTask(ID_HANDLER_B\x2C 3000\x2C queue);\x0d\n\x0d\n  scheduler.addDeviceTask(ID_DEVICE_A\x2C 4000\x2C null);\x0d\n\x0d\n  scheduler.addDeviceTask(ID_DEVICE_B\x2C 5000\x2C null);\x0d\n\x0d\n  scheduler.schedule();\x0d\n\x0d\n  if (scheduler.queueCount != EXPECTED_QUEUE_COUNT ||\x0d\n      scheduler.holdCount != EXPECTED_HOLD_COUNT) {\x0d\n    var msg =\x0d\n        "Error during execution: queueCount = " + scheduler.queueCount +\x0d\n        "\x2C holdCount = " + scheduler.holdCount + ".";\x0d\n    throw new Error(msg);\x0d\n  }\x0d\n}\x0d\n\x0d\nvar COUNT = 1000;\x0d\n\x0d\n/**\x0d\n * These two constants specify how many times a packet is queued and\x0d\n * how many times a task is put on hold in a correct run of richards.\x0d\n * They don't have any meaning a such but are characteristic of a\x0d\n * correct run so if the actual queue or hold count is different from\x0d\n * the expected there must be a bug in the implementation.\x0d\n **/\x0d\nvar EXPECTED_QUEUE_COUNT = 2322;\x0d\nvar EXPECTED_HOLD_COUNT = 928;\x0d\n\x0d\n\x0d\n/**\x0d\n * A scheduler can be used to schedule a set of tasks based on their relative\x0d\n * priorities.  Scheduling is done by maintaining a list of task control blocks\x0d\n * which holds tasks and the data queue they are processing.\x0d\n * @constructor\x0d\n */\x0d\nfunction Scheduler() {\x0d\n  this.queueCount = 0;\x0d\n  this.holdCount = 0;\x0d\n  this.blocks = new Array(NUMBER_OF_IDS);\x0d\n  this.list = null;\x0d\n  this.currentTcb = null;\x0d\n  this.currentId = null;\x0d\n}\x0d\n\x0d\nvar ID_IDLE       = 0;\x0d\nvar ID_WORKER     = 1;\x0d\nvar ID_HANDLER_A  = 2;\x0d\nvar ID_HANDLER_B  = 3;\x0d\nvar ID_DEVICE_A   = 4;\x0d\nvar ID_DEVICE_B   = 5;\x0d\nvar NUMBER_OF_IDS = 6;\x0d\n\x0d\nvar KIND_DEVICE   = 0;\x0d\nvar KIND_WORK     = 1;\x0d\n\x0d\n/**\x0d\n * Add an idle task to this scheduler.\x0d\n * @param {int} id the identity of the task\x0d\n * @param {int} priority the task's priority\x0d\n * @param {Packet} queue the queue of work to be processed by the task\x0d\n * @param {int} count the number of times to schedule the task\x0d\n */\x0d\nScheduler.prototype.addIdleTask = function (id\x2C priority\x2C queue\x2C count) {\x0d\n  this.addRunningTask(id\x2C priority\x2C queue\x2C new IdleTask(this\x2C 1\x2C count));\x0d\n};\x0d\n\x0d\n/**\x0d\n * Add a work task to this scheduler.\x0d\n * @param {int} id the identity of the task\x0d\n * @param {int} priority the task's priority\x0d\n * @param {Packet} queue the queue of work to be processed by the task\x0d\n */\x0d\nScheduler.prototype.addWorkerTask = function (id\x2C priority\x2C queue) {\x0d\n  this.addTask(id\x2C priority\x2C queue\x2C new WorkerTask(this\x2C ID_HANDLER_A\x2C 0));\x0d\n};\x0d\n\x0d\n/**\x0d\n * Add a handler task to this scheduler.\x0d\n * @param {int} id the identity of the task\x0d\n * @param {int} priority the task's priority\x0d\n * @param {Packet} queue the queue of work to be processed by the task\x0d\n */\x0d\nScheduler.prototype.addHandlerTask = function (id\x2C priority\x2C queue) {\x0d\n  this.addTask(id\x2C priority\x2C queue\x2C new HandlerTask(this));\x0d\n};\x0d\n\x0d\n/**\x0d\n * Add a handler task to this scheduler.\x0d\n * @param {int} id the identity of the task\x0d\n * @param {int} priority the task's priority\x0d\n * @param {Packet} queue the queue of work to be processed by the task\x0d\n */\x0d\nScheduler.prototype.addDeviceTask = function (id\x2C priority\x2C queue) {\x0d\n  this.addTask(id\x2C priority\x2C queue\x2C new DeviceTask(this))\x0d\n};\x0d\n\x0d\n/**\x0d\n * Add the specified task and mark it as running.\x0d\n * @param {int} id the identity of the task\x0d\n * @param {int} priority the task's priority\x0d\n * @param {Packet} queue the queue of work to be processed by the task\x0d\n * @param {Task} task the task to add\x0d\n */\x0d\nScheduler.prototype.addRunningTask = function (id\x2C priority\x2C queue\x2C task) {\x0d\n  this.addTask(id\x2C priority\x2C queue\x2C task);\x0d\n  this.currentTcb.setRunning();\x0d\n};\x0d\n\x0d\n/**\x0d\n * Add the specified task to this scheduler.\x0d\n * @param {int} id the identity of the task\x0d\n * @param {int} priority the task's priority\x0d\n * @param {Packet} queue the queue of work to be processed by the task\x0d\n * @param {Task} task the task to add\x0d\n */\x0d\nScheduler.prototype.addTask = function (id\x2C priority\x2C queue\x2C task) {\x0d\n  this.currentTcb = new TaskControlBlock(this.list\x2C id\x2C priority\x2C queue\x2C task);\x0d\n  this.list = this.currentTcb;\x0d\n  this.blocks[id] = this.currentTcb;\x0d\n};\x0d\n\x0d\n/**\x0d\n * Execute the tasks managed by this scheduler.\x0d\n */\x0d\nScheduler.prototype.schedule = function () {\x0d\n  this.currentTcb = this.list;\x0d\n  while (this.currentTcb != null) {\x0d\n    if (this.currentTcb.isHeldOrSuspended()) {\x0d\n      this.currentTcb = this.currentTcb.link;\x0d\n    } else {\x0d\n      this.currentId = this.currentTcb.id;\x0d\n      this.currentTcb = this.currentTcb.run();\x0d\n    }\x0d\n  }\x0d\n};\x0d\n\x0d\n/**\x0d\n * Release a task that is currently blocked and return the next block to run.\x0d\n * @param {int} id the id of the task to suspend\x0d\n */\x0d\nScheduler.prototype.release = function (id) {\x0d\n  var tcb = this.blocks[id];\x0d\n  if (tcb == null) return tcb;\x0d\n  tcb.markAsNotHeld();\x0d\n  if (tcb.priority > this.currentTcb.priority) {\x0d\n    return tcb;\x0d\n  } else {\x0d\n    return this.currentTcb;\x0d\n  }\x0d\n};\x0d\n\x0d\n/**\x0d\n * Block the currently executing task and return the next task control block\x0d\n * to run.  The blocked task will not be made runnable until it is explicitly\x0d\n * released\x2C even if new work is added to it.\x0d\n */\x0d\nScheduler.prototype.holdCurrent = function () {\x0d\n  this.holdCount++;\x0d\n  this.currentTcb.markAsHeld();\x0d\n  return this.currentTcb.link;\x0d\n};\x0d\n\x0d\n/**\x0d\n * Suspend the currently executing task and return the next task control block\x0d\n * to run.  If new work is added to the suspended task it will be made runnable.\x0d\n */\x0d\nScheduler.prototype.suspendCurrent = function () {\x0d\n  this.currentTcb.markAsSuspended();\x0d\n  return this.currentTcb;\x0d\n};\x0d\n\x0d\n/**\x0d\n * Add the specified packet to the end of the worklist used by the task\x0d\n * associated with the packet and make the task runnable if it is currently\x0d\n * suspended.\x0d\n * @param {Packet} packet the packet to add\x0d\n */\x0d\nScheduler.prototype.queue = function (packet) {\x0d\n  var t = this.blocks[packet.id];\x0d\n  if (t == null) return t;\x0d\n  this.queueCount++;\x0d\n  packet.link = null;\x0d\n  packet.id = this.currentId;\x0d\n  return t.checkPriorityAdd(this.currentTcb\x2C packet);\x0d\n};\x0d\n\x0d\n/**\x0d\n * A task control block manages a task and the queue of work packages associated\x0d\n * with it.\x0d\n * @param {TaskControlBlock} link the preceding block in the linked block list\x0d\n * @param {int} id the id of this block\x0d\n * @param {int} priority the priority of this block\x0d\n * @param {Packet} queue the queue of packages to be processed by the task\x0d\n * @param {Task} task the task\x0d\n * @constructor\x0d\n */\x0d\nfunction TaskControlBlock(link\x2C id\x2C priority\x2C queue\x2C task) {\x0d\n  this.link = link;\x0d\n  this.id = id;\x0d\n  this.priority = priority;\x0d\n  this.queue = queue;\x0d\n  this.task = task;\x0d\n  if (queue == null) {\x0d\n    this.state = STATE_SUSPENDED;\x0d\n  } else {\x0d\n    this.state = STATE_SUSPENDED_RUNNABLE;\x0d\n  }\x0d\n}\x0d\n\x0d\n/**\x0d\n * The task is running and is currently scheduled.\x0d\n */\x0d\nvar STATE_RUNNING = 0;\x0d\n\x0d\n/**\x0d\n * The task has packets left to process.\x0d\n */\x0d\nvar STATE_RUNNABLE = 1;\x0d\n\x0d\n/**\x0d\n * The task is not currently running.  The task is not blocked as such and may\x0d\n* be started by the scheduler.\x0d\n */\x0d\nvar STATE_SUSPENDED = 2;\x0d\n\x0d\n/**\x0d\n * The task is blocked and cannot be run until it is explicitly released.\x0d\n */\x0d\nvar STATE_HELD = 4;\x0d\n\x0d\nvar STATE_SUSPENDED_RUNNABLE = STATE_SUSPENDED | STATE_RUNNABLE;\x0d\nvar STATE_NOT_HELD = ~STATE_HELD;\x0d\n\x0d\nTaskControlBlock.prototype.setRunning = function () {\x0d\n  this.state = STATE_RUNNING;\x0d\n};\x0d\n\x0d\nTaskControlBlock.prototype.markAsNotHeld = function () {\x0d\n  this.state = this.state & STATE_NOT_HELD;\x0d\n};\x0d\n\x0d\nTaskControlBlock.prototype.markAsHeld = function () {\x0d\n  this.state = this.state | STATE_HELD;\x0d\n};\x0d\n\x0d\nTaskControlBlock.prototype.isHeldOrSuspended = function () {\x0d\n  return (this.state & STATE_HELD) != 0 || (this.state == STATE_SUSPENDED);\x0d\n};\x0d\n\x0d\nTaskControlBlock.prototype.markAsSuspended = function () {\x0d\n  this.state = this.state | STATE_SUSPENDED;\x0d\n};\x0d\n\x0d\nTaskControlBlock.prototype.markAsRunnable = function () {\x0d\n  this.state = this.state | STATE_RUNNABLE;\x0d\n};\x0d\n\x0d\n/**\x0d\n * Runs this task\x2C if it is ready to be run\x2C and returns the next task to run.\x0d\n */\x0d\nTaskControlBlock.prototype.run = function () {\x0d\n  var packet;\x0d\n  if (this.state == STATE_SUSPENDED_RUNNABLE) {\x0d\n    packet = this.queue;\x0d\n    this.queue = packet.link;\x0d\n    if (this.queue == null) {\x0d\n      this.state = STATE_RUNNING;\x0d\n    } else {\x0d\n      this.state = STATE_RUNNABLE;\x0d\n    }\x0d\n  } else {\x0d\n    packet = null;\x0d\n  }\x0d\n  return this.task.run(packet);\x0d\n};\x0d\n\x0d\n/**\x0d\n * Adds a packet to the worklist of this block's task\x2C marks this as runnable if\x0d\n * necessary\x2C and returns the next runnable object to run (the one\x0d\n * with the highest priority).\x0d\n */\x0d\nTaskControlBlock.prototype.checkPriorityAdd = function (task\x2C packet) {\x0d\n  if (this.queue == null) {\x0d\n    this.queue = packet;\x0d\n    this.markAsRunnable();\x0d\n    if (this.priority > task.priority) return this;\x0d\n  } else {\x0d\n    this.queue = packet.addTo(this.queue);\x0d\n  }\x0d\n  return task;\x0d\n};\x0d\n\x0d\nTaskControlBlock.prototype.toString = function () {\x0d\n  return "tcb { " + this.task + "@" + this.state + " }";\x0d\n};\x0d\n\x0d\n/**\x0d\n * An idle task doesn't do any work itself but cycles control between the two\x0d\n * device tasks.\x0d\n * @param {Scheduler} scheduler the scheduler that manages this task\x0d\n * @param {int} v1 a seed value that controls how the device tasks are scheduled\x0d\n * @param {int} count the number of times this task should be scheduled\x0d\n * @constructor\x0d\n */\x0d\nfunction IdleTask(scheduler\x2C v1\x2C count) {\x0d\n  this.scheduler = scheduler;\x0d\n  this.v1 = v1;\x0d\n  this.count = count;\x0d\n}\x0d\n\x0d\nIdleTask.prototype.run = function (packet) {\x0d\n  this.count--;\x0d\n  if (this.count == 0) return this.scheduler.holdCurrent();\x0d\n  if ((this.v1 & 1) == 0) {\x0d\n    this.v1 = this.v1 >> 1;\x0d\n    return this.scheduler.release(ID_DEVICE_A);\x0d\n  } else {\x0d\n    this.v1 = (this.v1 >> 1) ^ 0xD008;\x0d\n    return this.scheduler.release(ID_DEVICE_B);\x0d\n  }\x0d\n};\x0d\n\x0d\nIdleTask.prototype.toString = function () {\x0d\n  return "IdleTask"\x0d\n};\x0d\n\x0d\n/**\x0d\n * A task that suspends itself after each time it has been run to simulate\x0d\n * waiting for data from an external device.\x0d\n * @param {Scheduler} scheduler the scheduler that manages this task\x0d\n * @constructor\x0d\n */\x0d\nfunction DeviceTask(scheduler) {\x0d\n  this.scheduler = scheduler;\x0d\n  this.v1 = null;\x0d\n}\x0d\n\x0d\nDeviceTask.prototype.run = function (packet) {\x0d\n  if (packet == null) {\x0d\n    if (this.v1 == null) return this.scheduler.suspendCurrent();\x0d\n    var v = this.v1;\x0d\n    this.v1 = null;\x0d\n    return this.scheduler.queue(v);\x0d\n  } else {\x0d\n    this.v1 = packet;\x0d\n    return this.scheduler.holdCurrent();\x0d\n  }\x0d\n};\x0d\n\x0d\nDeviceTask.prototype.toString = function () {\x0d\n  return "DeviceTask";\x0d\n};\x0d\n\x0d\n/**\x0d\n * A task that manipulates work packets.\x0d\n * @param {Scheduler} scheduler the scheduler that manages this task\x0d\n * @param {int} v1 a seed used to specify how work packets are manipulated\x0d\n * @param {int} v2 another seed used to specify how work packets are manipulated\x0d\n * @constructor\x0d\n */\x0d\nfunction WorkerTask(scheduler\x2C v1\x2C v2) {\x0d\n  this.scheduler = scheduler;\x0d\n  this.v1 = v1;\x0d\n  this.v2 = v2;\x0d\n}\x0d\n\x0d\nWorkerTask.prototype.run = function (packet) {\x0d\n  if (packet == null) {\x0d\n    return this.scheduler.suspendCurrent();\x0d\n  } else {\x0d\n    if (this.v1 == ID_HANDLER_A) {\x0d\n      this.v1 = ID_HANDLER_B;\x0d\n    } else {\x0d\n      this.v1 = ID_HANDLER_A;\x0d\n    }\x0d\n    packet.id = this.v1;\x0d\n    packet.a1 = 0;\x0d\n    for (var i = 0; i < DATA_SIZE; i++) {\x0d\n      this.v2++;\x0d\n      if (this.v2 > 26) this.v2 = 1;\x0d\n      packet.a2[i] = this.v2;\x0d\n    }\x0d\n    return this.scheduler.queue(packet);\x0d\n  }\x0d\n};\x0d\n\x0d\nWorkerTask.prototype.toString = function () {\x0d\n  return "WorkerTask";\x0d\n};\x0d\n\x0d\n/**\x0d\n * A task that manipulates work packets and then suspends itself.\x0d\n * @param {Scheduler} scheduler the scheduler that manages this task\x0d\n * @constructor\x0d\n */\x0d\nfunction HandlerTask(scheduler) {\x0d\n  this.scheduler = scheduler;\x0d\n  this.v1 = null;\x0d\n  this.v2 = null;\x0d\n}\x0d\n\x0d\nHandlerTask.prototype.run = function (packet) {\x0d\n  if (packet != null) {\x0d\n    if (packet.kind == KIND_WORK) {\x0d\n      this.v1 = packet.addTo(this.v1);\x0d\n    } else {\x0d\n      this.v2 = packet.addTo(this.v2);\x0d\n    }\x0d\n  }\x0d\n  if (this.v1 != null) {\x0d\n    var count = this.v1.a1;\x0d\n    var v;\x0d\n    if (count < DATA_SIZE) {\x0d\n      if (this.v2 != null) {\x0d\n        v = this.v2;\x0d\n        this.v2 = this.v2.link;\x0d\n        v.a1 = this.v1.a2[count];\x0d\n        this.v1.a1 = count + 1;\x0d\n        return this.scheduler.queue(v);\x0d\n      }\x0d\n    } else {\x0d\n      v = this.v1;\x0d\n      this.v1 = this.v1.link;\x0d\n      return this.scheduler.queue(v);\x0d\n    }\x0d\n  }\x0d\n  return this.scheduler.suspendCurrent();\x0d\n};\x0d\n\x0d\nHandlerTask.prototype.toString = function () {\x0d\n  return "HandlerTask";\x0d\n};\x0d\n\x0d\n/* --- *\x0d\n * P a c k e t\x0d\n * --- */\x0d\n\x0d\nvar DATA_SIZE = 4;\x0d\n\x0d\n/**\x0d\n * A simple package of data that is manipulated by the tasks.  The exact layout\x0d\n * of the payload data carried by a packet is not importaint\x2C and neither is the\x0d\n * nature of the work performed on packets by the tasks.\x0d\n *\x0d\n * Besides carrying data\x2C packets form linked lists and are hence used both as\x0d\n * data and worklists.\x0d\n * @param {Packet} link the tail of the linked list of packets\x0d\n * @param {int} id an ID for this packet\x0d\n * @param {int} kind the type of this packet\x0d\n * @constructor\x0d\n */\x0d\nfunction Packet(link\x2C id\x2C kind) {\x0d\n  this.link = link;\x0d\n  this.id = id;\x0d\n  this.kind = kind;\x0d\n  this.a1 = 0;\x0d\n  this.a2 = new Array(DATA_SIZE);\x0d\n}\x0d\n\x0d\n/**\x0d\n * Add this packet to the end of a worklist\x2C and return the worklist.\x0d\n * @param {Packet} queue the worklist to add this packet to\x0d\n */\x0d\nPacket.prototype.addTo = function (queue) {\x0d\n  this.link = null;\x0d\n  if (queue == null) return this;\x0d\n  var peek\x2C next = queue;\x0d\n  while ((peek = next.link) != null)\x0d\n    next = peek;\x0d\n  next.link = this;\x0d\n  return queue;\x0d\n};\x0d\n\x0d\nPacket.prototype.toString = function () {\x0d\n  return "Packet";\x0d\n};\x0d\n\n;\n\n;(function(){\n var __cfSuite=BenchmarkSuite.suites[0]\x2C __cfTest=__cfSuite.benchmarks[0];\n if(__cfSuite.name!=='Richards' || __cfTest.name!=='Richards') throw Error('registration');\n BenchmarkSuite.ResetRNG(); __cfTest.Setup();\n var __cfStart=benchNow();\n for(var __cfRep=0;__cfRep<32;__cfRep++) __cfTest.run();\n var __cfStop=benchNow(); __cfTest.TearDown();\n console.log('RICHARDS '+JSON.stringify({N:32\x2Cstart_ms:__cfStart\x2Cstop_ms:__cfStop\x2C\n elapsed_ms:__cfStop-__cfStart\x2Ccorrectness:'PASS'\x2Cassertions_per_Run:1\x2Cwarmup_calls:0}));\n})();\n\nconsole.log('FEEDBACK isHeldOrSuspended');\n%DebugPrint(TaskControlBlock.prototype.isHeldOrSuspended);\nconsole.log('FEEDBACK schedule');\n%DebugPrint(Scheduler.prototype.schedule);\n
