 this;\x0d\n  return queue;\x0d\n};\x0d\n\x0d\nPacket.prototype.toString = function () {\x0d\n  return "Packet";\x0d\n};\x0d\n\n;\n\n;(function(){\n var __cfSuite=BenchmarkSuite.suites[0]\x2C __cfTest=__cfSuite.benchmarks[0];\n if(__cfSuite.name!=='Richards' || __cfTest.name!=='Richards') throw Error('registration');\n BenchmarkSuite.ResetRNG(); __cfTest.Setup();\n var __cfStart=benchNow();\n for(var __cfRep=0;__cfRep<1;__cfRep++) __cfTest.run();\n var __cfStop=benchNow(); __cfTest.TearDown();\n console.log('RICHARDS '+JSON.stringify({N:1\x2Cstart_ms:__cfStart\x2Cstop_ms:__cfStop\x2C\n elapsed_ms:__cfStop-__cfStart\x2Ccorrectness:'PASS'\x2Cassertions_per_Run:1\x2Cwarmup_calls:0}));\n})();\n\nconsole.log('FEEDBACK isHeldOrSuspended');\n%DebugPrint(TaskControlBlock.prototype.isHeldOrSuspended);\nconsole.log('FEEDBACK schedule');\n%DebugPrint(Scheduler.prototype.schedule);\n
