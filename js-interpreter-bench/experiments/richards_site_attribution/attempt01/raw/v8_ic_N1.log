script-source,5,/mnt/c/Users/mzyx/Desktop/0921/js-interpreter-bench/experiments/richards_site_attribution/attempt01/scripts/DIAGNOSTIC_v8_feedback.N1.js,// Copyright 2013 the V8 project authors. All rights reserved.\x0d\n// Redistribution and use in source and binary forms\x2C with or without\x0d\n// modification\x2C are permitted provided that the following conditions are\x0d\n// met:\x0d\n//\x0d\n//     * Redistributions of source code must retain the above copyright\x0d\n//       notice\x2C this list of conditions and the following disclaimer.\x0d\n//     * Redistributions in binary form must reproduce the above\x0d\n//       copyright notice\x2C this list of conditions and the following\x0d\n//       disclaimer in the documentation and/or other materials provided\x0d\n//       with the distribution.\x0d\n//     * Neither the name of Google Inc. nor the names of its\x0d\n//       contributors may be used to endorse or promote products derived\x0d\n//       from this software without specific prior written permission.\x0d\n//\x0d\n// THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS\x0d\n// "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES\x2C INCLUDING\x2C BUT NOT\x0d\n// LIMITED TO\x2C THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR\x0d\n// A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT\x0d\n// OWNER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT\x2C INDIRECT\x2C INCIDENTAL\x2C\x0d\n// SPECIAL\x2C EXEMPLARY\x2C OR CONSEQUENTIAL DAMAGES (INCLUDING\x2C BUT NOT\x0d\n// LIMITED TO\x2C PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE\x2C\x0d\n// DATA\x2C OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY\x0d\n// THEORY OF LIABILITY\x2C WHETHER IN CONTRACT\x2C STRICT LIABILITY\x2C OR TORT\x0d\n// (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE\x0d\n// OF THIS SOFTWARE\x2C EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\x0d\n\x0d\n\x0d\n// Performance.now is used in latency benchmarks\x2C the fallback is Date.now.\x0d\nvar performance = performance || {};\x0d\nperformance.now = (function() {\x0d\n  return performance.now       ||\x0d\n         performance.mozNow    ||\x0d\n         performance.msNow     ||\x0d\n         performance.oNow      ||\x0d\n         performance.webkitNow ||\x0d\n         Date.now;\x0d\n})();\x0d\n\x0d\n// Simple framework for running the benchmark suites and\x0d\n// computing a score based on the timing measurements.\x0d\n\x0d\n\x0d\n// A benchmark has a name (string) and a function that will be run to\x0d\n// do the performance measurement. The optional setup and tearDown\x0d\n// arguments are functions that will be invoked before and after\x0d\n// running the benchmark\x2C but the running time of these functions will\x0d\n// not be accounted for in the benchmark score.\x0d\nfunction Benchmark(name\x2C doWarmup\x2C doDeterministic\x2C deterministicIterations\x2C \x0d\n                   run\x2C setup\x2C tearDown\x2C rmsResult\x2C minIterations) {\x0d\n  this.name = name;\x0d\n  this.doWarmup = doWarmup;\x0d\n  this.doDeterministic = doDeterministic;\x0d\n  this.deterministicIterations = deterministicIterations;\x0d\n  this.run = run;\x0d\n  this.Setup = setup ? setup : function() { };\x0d\n  this.TearDown = tearDown ? tearDown : function() { };\x0d\n  this.rmsResult = rmsResult ? rmsResult : null; \x0d\n  this.minIterations = minIterations ? minIterations : 32;\x0d\n}\x0d\n\x0d\n\x0d\n// Benchmark results hold the benchmark and the measured time used to\x0d\n// run the benchmark. The benchmark score is computed later once a\x0d\n// full benchmark suite has run to completion. If latency is set to 0\x0d\n// then there is no latency score for this benchmark.\x0d\nfunction BenchmarkResult(benchmark\x2C time\x2C latency) {\x0d\n  this.benchmark = benchmark;\x0d\n  this.time = time;\x0d\n  this.latency = latency;\x0d\n}\x0d\n\x0d\n\x0d\n// Automatically convert results to numbers. Used by the geometric\x0d\n// mean computation.\x0d\nBenchmarkResult.prototype.valueOf = function() {\x0d\n  return this.time;\x0d\n}\x0d\n\x0d\n\x0d\n// Suites of benchmarks consist of a name and the set of benchmarks in\x0d\n// addition to the reference timing that the final score will be based\x0d\n// on. This way\x2C all scores are relative to a reference run and higher\x0d\n// scores implies better performance.\x0d\nfunction BenchmarkSuite(name\x2C reference\x2C benchmarks) {\x0d\n  this.name = name;\x0d\n  this.reference = reference;\x0d\n  this.benchmarks = benchmarks;\x0d\n  BenchmarkSuite.suites.push(this);\x0d\n}\x0d\n\x0d\n\x0d\n// Keep track of all declared benchmark suites.\x0d\nBenchmarkSuite.suites = [];\x0d\n\x0d\n// Scores are not comparable across versions. Bump the version if\x0d\n// you're making changes that will affect that scores\x2C e.g. if you add\x0d\n// a new benchmark or change an existing one.\x0d\nBenchmarkSuite.version = '9';\x0d\n\x0d\n\x0d\n// Defines global benchsuite running mode that overrides benchmark suite \x0d\n// behavior. Intended to be set by the benchmark driver. Undefined \x0d\n// values here allow a benchmark to define behaviour itself.\x0d\nBenchmarkSuite.config = {\x0d\n  doWarmup: undefined\x2C\x0d\n  doDeterministic: undefined\x0d\n};\x0d\n\x0d\n\x0d\n// Override the alert function to throw an exception instead.\x0d\nalert = function(s) {\x0d\n  throw "Alert called with argument: " + s;\x0d\n};\x0d\n\x0d\n\x0d\n// To make the benchmark results predictable\x2C we replace Math.random\x0d\n// with a 100% deterministic alternative.\x0d\nBenchmarkSuite.ResetRNG = function() {\x0d\n  Math.random = (function() {\x0d\n    var seed = 49734321;\x0d\n    return function() {\x0d\n      // Robert Jenkins' 32 bit integer hash function.\x0d\n      seed = ((seed + 0x7ed55d16) + (seed << 12))  & 0xffffffff;\x0d\n      seed = ((seed ^ 0xc761c23c) ^ (seed >>> 19)) & 0xffffffff;\x0d\n      seed = ((seed + 0x165667b1) + (seed << 5))   & 0xffffffff;\x0d\n      seed = ((seed + 0xd3a2646c) ^ (seed << 9))   & 0xffffffff;\x0d\n      seed = ((seed + 0xfd7046c5) + (seed << 3))   & 0xffffffff;\x0d\n      seed = ((seed ^ 0xb55a4f09) ^ (seed >>> 16)) & 0xffffffff;\x0d\n      return (seed & 0xfffffff) / 0x10000000;\x0d\n    };\x0d\n  })();\x0d\n}\x0d\n\x0d\n\x0d\n// Runs all registered benchmark suites and optionally yields between\x0d\n// each individual benchmark to avoid running for too long in the\x0d\n// context of browsers. Once done\x2C the final score is reported to the\x0d\n// runner.\x0d\nBenchmarkSuite.RunSuites = function(runner\x2C skipBenchmarks) {\x0d\n  skipBenchmarks = typeof skipBenchmarks === 'undefined' ? [] : skipBenchmarks;\x0d\n  var continuation = null;\x0d\n  var suites = BenchmarkSuite.suites;\x0d\n  var length = suites.length;\x0d\n  BenchmarkSuite.scores = [];\x0d\n  var index = 0;\x0d\n  function RunStep() {\x0d\n    while (continuation || index < length) {\x0d\n      if (continuation) {\x0d\n        continuation = continuation();\x0d\n      } else {\x0d\n        var suite = suites[index++];\x0d\n        if (runner.NotifyStart) runner.NotifyStart(suite.name);\x0d\n        if (skipBenchmarks.indexOf(suite.name) > -1) {\x0d\n          suite.NotifySkipped(runner);\x0d\n        } else {\x0d\n          continuation = suite.RunStep(runner);\x0d\n        }\x0d\n      }\x0d\n      if (continuation && typeof window != 'undefined' && window.setTimeout) {\x0d\n        window.setTimeout(RunStep\x2C 25);\x0d\n        return;\x0d\n      }\x0d\n    }\x0d\n\x0d\n    // show final result\x0d\n    if (runner.NotifyScore) {\x0d\n      var score = BenchmarkSuite.GeometricMean(BenchmarkSuite.scores);\x0d\n      var formatted = BenchmarkSuite.FormatScore(100 * score);\x0d\n      runner.NotifyScore(formatted);\x0d\n    }\x0d\n  }\x0d\n  RunStep();\x0d\n}\x0d\n\x0d\n\x0d\n// Counts the total number of registered benchmarks. Useful for\x0d\n// showing progress as a percentage.\x0d\nBenchmarkSuite.CountBenchmarks = function() {\x0d\n  var result = 0;\x0d\n  var suites = BenchmarkSuite.suites;\x0d\n  for (var i = 0; i < suites.length; i++) {\x0d\n    result += suites[i].benchmarks.length;\x0d\n  }\x0d\n  return result;\x0d\n}\x0d\n\x0d\n\x0d\n// Computes the geometric mean of a set of numbers.\x0d\nBenchmarkSuite.GeometricMean = function(numbers) {\x0d\n  var log = 0;\x0d\n  for (var i = 0; i < numbers.length; i++) {\x0d\n    log += Math.log(numbers[i]);\x0d\n  }\x0d\n  return Math.pow(Math.E\x2C log / numbers.length);\x0d\n}\x0d\n\x0d\n\x0d\n// Computes the geometric mean of a set of throughput time measurements.\x0d\nBenchmarkSuite.GeometricMeanTime = function(measurements) {\x0d\n  var log = 0;\x0d\n  for (var i = 0; i < measurements.length; i++) {\x0d\n    log += Math.log(measurements[i].time);\x0d\n  }\x0d\n  return Math.pow(Math.E\x2C log / measurements.length);\x0d\n}\x0d\n\x0d\n\x0d\n// Computes the geometric mean of a set of rms measurements.\x0d\nBenchmarkSuite.GeometricMeanLatency = function(measurements) {\x0d\n  var log = 0;\x0d\n  var hasLatencyResult = false;\x0d\n  for (var i = 0; i < measurements.length; i++) {\x0d\n    if (measurements[i].latency != 0) {\x0d\n      log += Math.log(measurements[i].latency);\x0d\n      hasLatencyResult = true;\x0d\n    }\x0d\n  }\x0d\n  if (hasLatencyResult) {\x0d\n    return Math.pow(Math.E\x2C log / measurements.length);\x0d\n  } else {\x0d\n    return 0;\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\n// Converts a score value to a string with at least three significant\x0d\n// digits.\x0d\nBenchmarkSuite.FormatScore = function(value) {\x0d\n  if (value > 100) {\x0d\n    return value.toFixed(0);\x0d\n  } else {\x0d\n    return value.toPrecision(3);\x0d\n  }\x0d\n}\x0d\n\x0d\n// Notifies the runner that we're done running a single benchmark in\x0d\n// the benchmark suite. This can be useful to report progress.\x0d\nBenchmarkSuite.prototype.NotifyStep = function(result) {\x0d\n  this.results.push(result);\x0d\n  if (this.runner.NotifyStep) this.runner.NotifyStep(result.benchmark.name);\x0d\n}\x0d\n\x0d\n\x0d\n// Notifies the runner that we're done with running a suite and that\x0d\n// we have a result which can be reported to the user if needed.\x0d\nBenchmarkSuite.prototype.NotifyResult = function() {\x0d\n  var mean = BenchmarkSuite.GeometricMeanTime(this.results);\x0d\n  var score = this.reference[0] / mean;\x0d\n  BenchmarkSuite.scores.push(score);\x0d\n  if (this.runner.NotifyResult) {\x0d\n    var formatted = BenchmarkSuite.FormatScore(100 * score);\x0d\n    this.runner.NotifyResult(this.name\x2C formatted);\x0d\n  }\x0d\n  if (this.reference.length == 2) {\x0d\n    var meanLatency = BenchmarkSuite.GeometricMeanLatency(this.results);\x0d\n    if (meanLatency != 0) {\x0d\n      var scoreLatency = this.reference[1] / meanLatency;\x0d\n      BenchmarkSuite.scores.push(scoreLatency);\x0d\n      if (this.runner.NotifyResult) {\x0d\n        var formattedLatency = BenchmarkSuite.FormatScore(100 * scoreLatency)\x0d\n        this.runner.NotifyResult(this.name + "Latency"\x2C formattedLatency);\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\nBenchmarkSuite.prototype.NotifySkipped = function(runner) {\x0d\n  BenchmarkSuite.scores.push(1);  // push default reference score.\x0d\n  if (runner.NotifyResult) {\x0d\n    runner.NotifyResult(this.name\x2C "Skipped");\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\n// Notifies the runner that running a benchmark resulted in an error.\x0d\nBenchmarkSuite.prototype.NotifyError = function(error) {\x0d\n  if (this.runner.NotifyError) {\x0d\n    this.runner.NotifyError(this.name\x2C error);\x0d\n  }\x0d\n  if (this.runner.NotifyStep) {\x0d\n    this.runner.NotifyStep(this.name);\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\n// Runs a single benchmark for at least a second and computes the\x0d\n// average time it takes to run a single iteration.\x0d\nBenchmarkSuite.prototype.RunSingleBenchmark = function(benchmark\x2C data) {\x0d\n  var config = BenchmarkSuite.config;\x0d\n  var doWarmup = config.doWarmup !== undefined \x0d\n                 ? config.doWarmup \x0d\n                 : benchmark.doWarmup;\x0d\n  var doDeterministic = config.doDeterministic !== undefined \x0d\n                        ? config.doDeterministic \x0d\n                        : benchmark.doDeterministic;\x0d\n\x0d\n  function Measure(data) {\x0d\n    var elapsed = 0;\x0d\n    var start = new Date();\x0d\n  \x0d\n  // Run either for 1 second or for the number of iterations specified\x0d\n  // by minIterations\x2C depending on the config flag doDeterministic.\x0d\n    for (var i = 0; (doDeterministic ? \x0d\n      i<benchmark.deterministicIterations : elapsed < 1000); i++) {\x0d\n      benchmark.run();\x0d\n      elapsed = new Date() - start;\x0d\n    }\x0d\n    if (data != null) {\x0d\n      data.runs += i;\x0d\n      data.elapsed += elapsed;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  // Sets up data in order to skip or not the warmup phase.\x0d\n  if (!doWarmup && data == null) {\x0d\n    data = { runs: 0\x2C elapsed: 0 };\x0d\n  }\x0d\n\x0d\n  if (data == null) {\x0d\n    Measure(null);\x0d\n    return { runs: 0\x2C elapsed: 0 };\x0d\n  } else {\x0d\n    Measure(data);\x0d\n    // If we've run too few iterations\x2C we continue for another second.\x0d\n    if (data.runs < benchmark.minIterations) return data;\x0d\n    var usec = (data.elapsed * 1000) / data.runs;\x0d\n    var rms = (benchmark.rmsResult != null) ? benchmark.rmsResult() : 0;\x0d\n    this.NotifyStep(new BenchmarkResult(benchmark\x2C usec\x2C rms));\x0d\n    return null;\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\n// This function starts running a suite\x2C but stops between each\x0d\n// individual benchmark in the suite and returns a continuation\x0d\n// function which can be invoked to run the next benchmark. Once the\x0d\n// last benchmark has been executed\x2C null is returned.\x0d\nBenchmarkSuite.prototype.RunStep = function(runner) {\x0d\n  BenchmarkSuite.ResetRNG();\x0d\n  this.results = [];\x0d\n  this.runner = runner;\x0d\n  var length = this.benchmarks.length;\x0d\n  var index = 0;\x0d\n  var suite = this;\x0d\n  var data;\x0d\n\x0d\n  // Run the setup\x2C the actual benchmark\x2C and the tear down in three\x0d\n  // separate steps to allow the framework to yield between any of the\x0d\n  // steps.\x0d\n\x0d\n  function RunNextSetup() {\x0d\n    if (index < length) {\x0d\n      try {\x0d\n        suite.benchmarks[index].Setup();\x0d\n      } catch (e) {\x0d\n        suite.NotifyError(e);\x0d\n        return null;\x0d\n      }\x0d\n      return RunNextBenchmark;\x0d\n    }\x0d\n    suite.NotifyResult();\x0d\n    return null;\x0d\n  }\x0d\n\x0d\n  function RunNextBenchmark() {\x0d\n    try {\x0d\n      data = suite.RunSingleBenchmark(suite.benchmarks[index]\x2C data);\x0d\n    } catch (e) {\x0d\n      suite.NotifyError(e);\x0d\n      return null;\x0d\n    }\x0d\n    // If data is null\x2C we're done with this benchmark.\x0d\n    return (data == null) ? RunNextTearDown : RunNextBenchmark();\x0d\n  }\x0d\n\x0d\n  function RunNextTearDown() {\x0d\n    try {\x0d\n      suite.benchmarks[index++].TearDown();\x0d\n    } catch (e) {\x0d\n      suite.NotifyError(e);\x0d\n      return null;\x0d\n    }\x0d\n    return RunNextSetup;\x0d\n  }\x0d\n\x0d\n  // Start out running the setup.\x0d\n  return RunNextSetup();\x0d\n}\x0d\n\n;\n// Copyright 2006-2008 the V8 project authors. All rights reserved.\x0d\n// Redistribution and use in source and binary forms\x2C with or without\x0d\n// modification\x2C are permitted provided that the following conditions are\x0d\n// met:\x0d\n//\x0d\n//     * Redistributions of source code must retain the above copyright\x0d\n//       notice\x2C this list of conditions and the following disclaimer.\x0d\n//     * Redistributions in binary form must reproduce the above\x0d\n//       copyright notice\x2C this list of conditions and the following\x0d\n//       disclaimer in the documentation and/or other materials provided\x0d\n//       with the distribution.\x0d\n//     * Neither the name of Google Inc