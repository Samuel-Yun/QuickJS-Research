C KIND_DEVICE);\x0d\n  queue = new Packet(queue\x2C  ID_DEVICE_A\x2C KIND_DEVICE);\x0d\n  queue = new Packet(queue\x2C  ID_DEVICE_A\x2C KIND_DEVICE);\x0d\n  scheduler.addHandlerTask(ID_HANDLER_A\x2C 2000\x2C queue);\x0d\n\x0d\n  queue = new Packet(null\x2C ID_DEVICE_B\x2C KIND_DEVICE);\x0d\n  queue = new Packet(queue\x2C  ID_DEVICE_B\x2C KIND_DEVICE);\x0d\n  queue = new Packet(queue\x2C  ID_DEVICE_B\x2C KIND_DEVICE);\x0d\n  scheduler.addHandlerTask(ID_HANDLER_B\x2C 3000\x2C queue);\x0d\n\x0d\n  scheduler.addDeviceTask(ID_DEVICE_A\x2C 4000\x2C null);\x0d\n\x0d\n  scheduler.addDeviceTask(ID_DEVICE_B\x2C 5000\x2C null);\x0d\n\x0d\n  scheduler.schedule();\x0d\n\x0d\n  if (scheduler.queueCount != EXPECTED_QUEUE_COUNT ||\x0d\n      scheduler.holdCount != EXPECTED_HOLD_COUNT) {\x0d\n    var msg =\x0d\n        "Error during execution: queueCount = " + scheduler.queueCount +\x0d\n        "\x2C holdCount = " + scheduler.holdCount + ".";\x0d\n    throw new Error(msg);\x0d\n  }\x0d\n}\x0d\n\x0d\nvar COUNT = 1000;\x0d\n\x0d\n/**\x0d\n * These two constants specify how many times a packet is queued and\x0d\n * how many times a task is put on hold in a correct run of richards.\x0d\n * They don't have any meaning a such but are characteristic of a\x0d\n * correct run so if the actual queue or hold count is different from\x0d\n * the expected there must be a bug in the implementation.\x0d\n **/\x0d\nvar EXPECTED_QUEUE_COUNT = 2322;\x0d\nvar EXPECTED_HOLD_COUNT = 928;\x0d\n\x0d\n\x0d\n/**\x0d\n * A scheduler can be used to schedule a set of tasks based on their relative\x0d\n * priorities.  Scheduling is done by maintaining a list of task control blocks\x0d\n * which holds tasks and the data queue they are processing.\x0d\n * @constructor\x0d\n */\x0d\nfunction Scheduler() {\x0d\n  this.queueCount = 0;\x0d\n  this.holdCount = 0;\x0d\n  this.blocks = new Array(NUMBER_OF_IDS);\x0d\n  this.list = null;\x0d\n  this.currentTcb = null;\x0d\n  this.currentId = null;\x0d\n}\x0d\n\x0d\nvar ID_IDLE       = 0;\x0d\nvar ID_WORKER     = 1;\x0d\nvar ID_HANDLER_A  = 2;\x0d\nvar ID_HANDLER_B  = 3;\x0d\nvar ID_DEVICE_A   = 4;\x0d\nvar ID_DEVICE_B   = 5;\x0d\nvar NUMBER_OF_IDS = 6;\x0d\n\x0d\nvar KIND_DEVICE   = 0;\x0d\nvar KIND_WORK     = 1;\x0d\n\x0d\n/**\x0d\n * Add an idle task to this scheduler.\x0d\n * @param {int} id the identity of the task\x0d\n * @param {int} priority the task's priority\x0d\n * @param {Packet} queue the queue of work to be processed by the task\x0d\n * @param {int} count the number of times to schedule the task\x0d\n */\x0d\nScheduler.prototype.addIdleTask = function (id\x2C priority\x2C queue\x2C count) {\x0d\n  this.addRunningTask(id\x2C priority\x2C queue\x2C new IdleTask(this\x2C 1\x2C count));\x0d\n};\x0d\n\x0d\n/**\x0d\n * Add a work task to this scheduler.\x0d\n * @param {int} id the identity of the task\x0d\n * @param {int} priority the task's priority\x0d\n * @param {Packet} queue the queue of work to be processed by the task\x0d\n */\x0d\nScheduler.prototype.addWorkerTask = function (id\x2C priority\x2C queue) {\x0d\n  this.addTask(id\x2C priority\x2C queue\x2C new WorkerTask(this\x2C ID_HANDLER_A\x2C 0));\x0d\n};\x0d\n\x0d\n/**\x0d\n * Add a handler task to this scheduler.\x0d\n * @param {int} id the identity of the task\x0d\n * @param {int} priority the task's priority\x0d\n * @param {Packet} queue the queue of work to be processed by the task\x0d\n */\x0d\nScheduler.prototype.addHandlerTask = function (id\x2C priority\x2C queue) {\x0d\n  this.addTask(id\x2C priority\x2C queue\x2C new HandlerTask(this));\x0d\n};\x0d\n\x0d\n/**\x0d\n * Add a handler task to this scheduler.\x0d\n * @param {int} id the identity of the task\x0d\n * @param {int} priority the task's priority\x0d\n * @param {Packet} queue the queue of work to be processed by the task\x0d\n */\x0d\nScheduler.prototype.addDeviceTask = function (id\x2C priority\x2C queue) {\x0d\n  this.addTask(id\x2C priority\x2C queue\x2C new DeviceTask(this))\x0d\n};\x0d\n\x0d\n/**\x0d\n * Add the specified task and mark it as running.\x0d\n * @param {int} id the identity of the task\x0d\n * @param {int} priority the task's priority\x0d\n * @param {Packet} queue the queue of work to be processed by the task\x0d\n * @param {Task} task the task to add\x0d\n */\x0d\nScheduler.prototype.addRunningTask = function (id\x2C priority\x2C queue\x2C task) {\x0d\n  this.addTask(id\x2C priority\x2C queue\x2C task);\x0d\n  this.currentTcb.setRunning();\x0d\n};\x0d\n\x0d\n/**\x0d\n * Add the specified task to this scheduler.\x0d\n * @param {int} id the identity of the task\x0d\n * @param {int} priority the task's priority\x0d\n * @param {Packet} queue the queue of work to be processed by the task\x0d\n * @param {Task} task the task to add\x0d\n */\x0d\nScheduler.prototype.addTask = function (id\x2C priority\x2C queue\x2C task) {\x0d\n  this.currentTcb = new TaskControlBlock(this.list\x2C id\x2C priority\x2C queue\x2C task);\x0d\n  this.list = this.currentTcb;\x0d\n  this.blocks[id] = this.currentTcb;\x0d\n};\x0d\n\x0d\n/**\x0d\n * Execute the tasks managed by this scheduler.\x0d\n */\x0d\nScheduler.prototype.schedule = function () {\x0d\n  this.currentTcb = this.list;\x0d\n  while (this.currentTcb != null) {\x0d\n    if (this.currentTcb.isHeldOrSuspended()) {\x0d\n      this.currentTcb = this.currentTcb.link;\x0d\n    } else {\x0d\n      this.currentId = this.currentTcb.id;\x0d\n      this.currentTcb = this.currentTcb.run();\x0d\n    }\x0d\n  }\x0d\n};\x0d\n\x0d\n/**\x0d\n * Release a task that is currently blocked and return the next block to run.\x0d\n * @param {int} id the id of the task to suspend\x0d\n */\x0d\nScheduler.prototype.release = function (id) {\x0d\n  var tcb = this.blocks[id];\x0d\n  if (tcb == null) return tcb;\x0d\n  tcb.markAsNotHeld();\x0d\n  if (tcb.priority > this.currentTcb.priority) {\x0d\n    return tcb;\x0d\n  } else {\x0d\n    return this.currentTcb;\x0d\n  }\x0d\n};\x0d\n\x0d\n/**\x0d\n * Block the currently executing task and return the next task control block\x0d\n * to run.  The blocked task will not be made runnable until it is explicitly\x0d\n * released\x2C even if new work is added to it.\x0d\n */\x0d\nScheduler.prototype.holdCurrent = function () {\x0d\n  this.holdCount++;\x0d\n  this.currentTcb.markAsHeld();\x0d\n  return this.currentTcb.link;\x0d\n};\x0d\n\x0d\n/**\x0d\n * Suspend the currently executing task and return the next task control block\x0d\n * to run.  If new work is added to the suspended task it will be made runnable.\x0d\n */\x0d\nScheduler.prototype.suspendCurrent = function () {\x0d\n  this.currentTcb.markAsSuspended();\x0d\n  return this.currentTcb;\x0d\n};\x0d\n\x0d\n/**\x0d\n * Add the specified packet to the end of the worklist used by the task\x0d\n * associated with the packet and make the task runnable if it is currently\x0d\n * suspended.\x0d\n * @param {Packet} packet the packet to add\x0d\n */\x0d\nScheduler.prototype.queue = function (packet) {\x0d\n  var t = this.blocks[packet.id];\x0d\n  if (t == null) return t;\x0d\n  this.queueCount++;\x0d\n  packet.link = null;\x0d\n  packet.id = this.currentId;\x0d\n  return t.checkPriorityAdd(this.currentTcb\x2C packet);\x0d\n};\x0d\n\x0d\n/**\x0d\n * A task control block manages a task and the queue of work packages associated\x0d\n * with it.\x0d\n * @param {TaskControlBlock} link the preceding block in the linked block list\x0d\n * @param {int} id the id of this block\x0d\n * @param {int} priority the priority of this block\x0d\n * @param {Packet} queue the queue of packages to be processed by the task\x0d\n * @param {Task} task the task\x0d\n * @constructor\x0d\n */\x0d\nfunction TaskControlBlock(link\x2C id\x2C priority\x2C queue\x2C task) {\x0d\n  this.link = link;\x0d\n  this.id = id;\x0d\n  this.priority = priority;\x0d\n  this.queue = queue;\x0d\n  this.task = task;\x0d\n  if (queue == null) {\x0d\n    this.state = STATE_SUSPENDED;\x0d\n  } else {\x0d\n    this.state = STATE_SUSPENDED_RUNNABLE;\x0d\n  }\x0d\n}\x0d\n\x0d\n/**\x0d\n * The task is running and is currently scheduled.\x0d\n */\x0d\nvar STATE_RUNNING = 0;\x0d\n\x0d\n/**\x0d\n * The task has packets left to process.\x0d\n */\x0d\nvar STATE_RUNNABLE = 1;\x0d\n\x0d\n/**\x0d\n * The task is not currently running.  The task is not blocked as such and may\x0d\n* be started by the scheduler.\x0d\n */\x0d\nvar STATE_SUSPENDED = 2;\x0d\n\x0d\n/**\x0d\n * The task is blocked and cannot be run until it is explicitly released.\x0d\n */\x0d\nvar STATE_HELD = 4;\x0d\n\x0d\nvar STATE_SUSPENDED_RUNNABLE = STATE_SUSPENDED | STATE_RUNNABLE;\x0d\nvar STATE_NOT_HELD = ~STATE_HELD;\x0d\n\x0d\nTaskControlBlock.prototype.setRunning = function () {\x0d\n  this.state = STATE_RUNNING;\x0d\n};\x0d\n\x0d\nTaskControlBlock.prototype.markAsNotHeld = function () {\x0d\n  this.state = this.state & STATE_NOT_HELD;\x0d\n};\x0d\n\x0d\nTaskControlBlock.prototype.markAsHeld = function () {\x0d\n  this.state = this.state | STATE_HELD;\x0d\n};\x0d\n\x0d\nTaskControlBlock.prototype.isHeldOrSuspended = function () {\x0d\n  return (this.state & STATE_HELD) != 0 || (this.state == STATE_SUSPENDED);\x0d\n};\x0d\n\x0d\nTaskControlBlock.prototype.markAsSuspended = function () {\x0d\n  this.state = this.state | STATE_SUSPENDED;\x0d\n};\x0d\n\x0d\nTaskControlBlock.prototype.markAsRunnable = function () {\x0d\n  this.state = this.state | STATE_RUNNABLE;\x0d\n};\x0d\n\x0d\n/**\x0d\n * Runs this task\x2C if it is ready to be run\x2C and returns the next task to run.\x0d\n */\x0d\nTaskControlBlock.prototype.run = function () {\x0d\n  var packet;\x0d\n  if (this.state == STATE_SUSPENDED_RUNNABLE) {\x0d\n    packet = this.queue;\x0d\n    this.queue = packet.link;\x0d\n    if (this.queue == null) {\x0d\n      this.state = STATE_RUNNING;\x0d\n    } else {\x0d\n      this.state = STATE_RUNNABLE;\x0d\n    }\x0d\n  } else {\x0d\n    packet = null;\x0d\n  }\x0d\n  return this.task.run(packet);\x0d\n};\x0d\n\x0d\n/**\x0d\n * Adds a packet to the worklist of this block's task\x2C marks this as runnable if\x0d\n * necessary\x2C and returns the next runnable object to run (the one\x0d\n * with the highest priority).\x0d\n */\x0d\nTaskControlBlock.prototype.checkPriorityAdd = function (task\x2C packet) {\x0d\n  if (this.queue == null) {\x0d\n    this.queue = packet;\x0d\n    this.markAsRunnable();\x0d\n    if (this.priority > task.priority) return this;\x0d\n  } else {\x0d\n    this.queue = packet.addTo(this.queue);\x0d\n  }\x0d\n  return task;\x0d\n};\x0d\n\x0d\nTaskControlBlock.prototype.toString = function () {\x0d\n  return "tcb { " + this.task + "@" + this.state + " }";\x0d\n};\x0d\n\x0d\n/**\x0d\n * An idle task doesn't do any work itself but cycles control between the two\x0d\n * device tasks.\x0d\n * @param {Scheduler} scheduler the scheduler that manages this task\x0d\n * @param {int} v1 a seed value that controls how the device tasks are scheduled\x0d\n * @param {int} count the number of times this task should be scheduled\x0d\n * @constructor\x0d\n */\x0d\nfunction IdleTask(scheduler\x2C v1\x2C count) {\x0d\n  this.scheduler = scheduler;\x0d\n  this.v1 = v1;\x0d\n  this.count = count;\x0d\n}\x0d\n\x0d\nIdleTask.prototype.run = function (packet) {\x0d\n  this.count--;\x0d\n  if (this.count == 0) return this.scheduler.holdCurrent();\x0d\n  if ((this.v1 & 1) == 0) {\x0d\n    this.v1 = this.v1 >> 1;\x0d\n    return this.scheduler.release(ID_DEVICE_A);\x0d\n  } else {\x0d\n    this.v1 = (this.v1 >> 1) ^ 0xD008;\x0d\n    return this.scheduler.release(ID_DEVICE_B);\x0d\n  }\x0d\n};\x0d\n\x0d\nIdleTask.prototype.toString = function () {\x0d\n  return "IdleTask"\x0d\n};\x0d\n\x0d\n/**\x0d\n * A task that suspends itself after each time it has been run to simulate\x0d\n * waiting for data from an external device.\x0d\n * @param {Scheduler} scheduler the scheduler that manages this task\x0d\n * @constructor\x0d\n */\x0d\nfunction DeviceTask(scheduler) {\x0d\n  this.scheduler = scheduler;\x0d\n  this.v1 = null;\x0d\n}\x0d\n\x0d\nDeviceTask.prototype.run = function (packet) {\x0d\n  if (packet == null) {\x0d\n    if (this.v1 == null) return this.scheduler.suspendCurrent();\x0d\n    var v = this.v1;\x0d\n    this.v1 = null;\x0d\n    return this.scheduler.queue(v);\x0d\n  } else {\x0d\n    this.v1 = packet;\x0d\n    return this.scheduler.holdCurrent();\x0d\n  }\x0d\n};\x0d\n\x0d\nDeviceTask.prototype.toString = function () {\x0d\n  return "DeviceTask";\x0d\n};\x0d\n\x0d\n/**\x0d\n * A task that manipulates work packets.\x0d\n * @param {Scheduler} scheduler the scheduler that manages this task\x0d\n * @param {int} v1 a seed used to specify how work packets are manipulated\x0d\n * @param {int} v2 another seed used to specify how work packets are manipulated\x0d\n * @constructor\x0d\n */\x0d\nfunction WorkerTask(scheduler\x2C v1\x2C v2) {\x0d\n  this.scheduler = scheduler;\x0d\n  this.v1 = v1;\x0d\n  this.v2 = v2;\x0d\n}\x0d\n\x0d\nWorkerTask.prototype.run = function (packet) {\x0d\n  if (packet == null) {\x0d\n    return this.scheduler.suspendCurrent();\x0d\n  } else {\x0d\n    if (this.v1 == ID_HANDLER_A) {\x0d\n      this.v1 = ID_HANDLER_B;\x0d\n    } else {\x0d\n      this.v1 = ID_HANDLER_A;\x0d\n    }\x0d\n    packet.id = this.v1;\x0d\n    packet.a1 = 0;\x0d\n    for (var i = 0; i < DATA_SIZE; i++) {\x0d\n      this.v2++;\x0d\n      if (this.v2 > 26) this.v2 = 1;\x0d\n      packet.a2[i] = this.v2;\x0d\n    }\x0d\n    return this.scheduler.queue(packet);\x0d\n  }\x0d\n};\x0d\n\x0d\nWorkerTask.prototype.toString = function () {\x0d\n  return "WorkerTask";\x0d\n};\x0d\n\x0d\n/**\x0d\n * A task that manipulates work packets and then suspends itself.\x0d\n * @param {Scheduler} scheduler the scheduler that manages this task\x0d\n * @constructor\x0d\n */\x0d\nfunction HandlerTask(scheduler) {\x0d\n  this.scheduler = scheduler;\x0d\n  this.v1 = null;\x0d\n  this.v2 = null;\x0d\n}\x0d\n\x0d\nHandlerTask.prototype.run = function (packet) {\x0d\n  if (packet != null) {\x0d\n    if (packet.kind == KIND