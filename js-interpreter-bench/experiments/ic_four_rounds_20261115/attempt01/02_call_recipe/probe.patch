--- a/four_diag.inc
+++ b/four_diag.inc
@@ -0,0 +1,49 @@
+#ifdef FOUR_DIAG
+#pragma push_macro("free")
+#undef free
+typedef struct FourDiag {
+    uint64_t q,h,eligible,fill,guard,overflow;
+    unsigned pc;
+    char *name,*target;
+    char bytes[257];
+    struct FourDiag *next;
+} FourDiag;
+static FourDiag *four_dlist;
+static int four_active;
+static FourDiag *four_dnew(JSContext *ctx,JSFunctionBytecode *b,unsigned pc)
+{
+    FourDiag *d=calloc(1,sizeof(*d));assert(d);d->pc=pc;
+    const char *n=JS_AtomToCString(ctx,b->func_name);assert(n);
+    d->name=strdup(n);assert(d->name);JS_FreeCString(ctx,n);
+    unsigned count=min_int(128,b->byte_code_len-pc);
+    for(unsigned i=0;i<count;i++)snprintf(d->bytes+2*i,3,"%02x",b->byte_code_buf[pc+i]);
+    d->next=four_dlist;four_dlist=d;return d;
+}
+#define FOUR_COUNT(s,k) do{if(four_active)(s)->diag->k++;}while(0)
+static void four_json_string(const char *s)
+{
+    fputc('"',stderr);
+    for(const unsigned char *p=(const unsigned char*)s;*p;p++) {
+        if(*p=='"'||*p=='\\'){fputc('\\',stderr);fputc(*p,stderr);}
+        else if(*p<32)fprintf(stderr,"\\u%04x",*p);else fputc(*p,stderr);
+    }
+    fputc('"',stderr);
+}
+void four_begin(void){four_active=1;}
+void four_end(void)
+{
+    four_active=0;uint64_t q=0,h=0,e=0,f=0,g=0,o=0;
+    for(FourDiag*d=four_dlist;d;d=d->next){q+=d->q;h+=d->h;e+=d->eligible;f+=d->fill;g+=d->guard;o+=d->overflow;}
+    fprintf(stderr,"FOUR_COUNTS:{\"attempts\":%llu,\"hits\":%llu,\"eligible\":%llu,\"fills\":%llu,\"fallbacks\":%llu,\"overflow\":%llu,\"sites\":[",
+        (unsigned long long)q,(unsigned long long)h,(unsigned long long)e,(unsigned long long)f,(unsigned long long)g,(unsigned long long)o);
+    unsigned k=0;for(FourDiag*d=four_dlist;d;d=d->next)if(d->q){
+        fprintf(stderr,"%s{\"function\":",k++?",":"");four_json_string(d->name);
+        if(d->target){fprintf(stderr,",\"target\":");four_json_string(d->target);}
+        fprintf(stderr,",\"pc\":%u,\"attempts\":%llu,\"hits\":%llu,\"eligible\":%llu,\"fills\":%llu,\"fallbacks\":%llu,\"overflow\":%llu,\"bytecode_hex\":\"%s\"}",d->pc,
+            (unsigned long long)d->q,(unsigned long long)d->h,(unsigned long long)d->eligible,(unsigned long long)d->fill,(unsigned long long)d->guard,(unsigned long long)d->overflow,d->bytes);
+    }fprintf(stderr,"]}\n");
+}
+#pragma pop_macro("free")
+#else
+#define FOUR_COUNT(s,k) ((void)0)
+#endif
--- a/four_probe.inc
+++ b/four_probe.inc
@@ -0,0 +1,26 @@
+/* Inspection of already resolved callees only. Copies no JS references. */
+typedef struct FourCallProbe {unsigned owner,target,pc,kind;FourDiag *diag;struct FourCallProbe *next;} FourCallProbe;
+static FourCallProbe *four_call_buckets[65536];
+static unsigned four_identity;
+static void four_observe_call(JSContext*ctx,JSFunctionBytecode*b,const uint8_t*pc,JSValueConst callee,int kind)
+{
+    if(!four_active || JS_VALUE_GET_TAG(callee)!=JS_TAG_OBJECT)return;
+    JSObject*o=JS_VALUE_GET_OBJ(callee);
+    if(o->class_id!=JS_CLASS_BYTECODE_FUNCTION && o->class_id!=JS_CLASS_COLD_BYTECODE_FUNCTION)return;
+    JSFunctionBytecode*t=o->u.func.function_bytecode;
+    if(t->func_kind!=JS_FUNC_NORMAL || t->byte_code_len>128)return;
+    if(!b->four_count)b->four_count=++four_identity;
+    if(!t->four_count)t->four_count=++four_identity;
+    unsigned pos=pc-b->byte_code_buf,key=(b->four_count*7159u+pos*131u+t->four_count*17u+kind)&65535;
+    FourCallProbe *s;
+    for(s=four_call_buckets[key];s;s=s->next)if(s->owner==b->four_count && s->target==t->four_count && s->pc==pos && s->kind==(unsigned)kind)break;
+    if(!s){
+        s=calloc(1,sizeof(*s));assert(s);s->owner=b->four_count;s->target=t->four_count;s->pc=pos;s->kind=kind;
+        s->diag=four_dnew(ctx,b,pos);
+        const char*n=JS_AtomToCString(ctx,t->func_name);assert(n);s->diag->target=strdup(n);JS_FreeCString(ctx,n);
+        memset(s->diag->bytes,0,sizeof(s->diag->bytes));
+        for(int i=0;i<t->byte_code_len;i++)snprintf(s->diag->bytes+2*i,3,"%02x",t->byte_code_buf[i]);
+        s->next=four_call_buckets[key];four_call_buckets[key]=s;
+    }
+    s->diag->q++;s->diag->guard++;if(kind)s->diag->eligible++;
+}
