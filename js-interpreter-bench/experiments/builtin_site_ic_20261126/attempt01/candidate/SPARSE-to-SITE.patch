+    BuiltinTable*t=b->builtin_sites;
+    if(!t){t=js_mallocz_rt(ctx->rt,sizeof(*t));if(!t)return NULL;b->builtin_sites=t;BIC_G(8);}
+    if(t->count==65536)return NULL;
