  "source": "function valueReadLoop(obj, expected) {\n    var sum = 0, last;\n    for (var i = 0; i < 4096; i++) {\n        last = obj.slot;\n        sum += i + 1;\n    }\n    if (last !== expected) throw Error(\"value identity\");\n    return sum;\n}",
