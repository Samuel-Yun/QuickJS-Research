@@ -1,3 +1,13 @@
+/* Final source-compiled code is counted before the owning function allocation. */
+static uint32_t rdi_count_fields(const uint8_t *code, int length)
+{
+    uint32_t count = 0;
+    for (int pos = 0, op; pos < length; pos += short_opcode_info(op).size) {
+        op = code[pos];
+        if (op == OP_get_field || op == OP_get_field2) count++;
+    }
+    return count;
+}
 /* Called only for fully built b, after all compiler passes / atom fixups. */
