+/* Always validate the current descriptor. A recycled PC can at most suggest
+   the wrong offset. No entry owns or dereferences an old function or shape. */
+static JSProperty *instance_proto_property(JSContext *ctx, JSObject *ctor, uintptr_t site)
+{
+    JSShape *shape = ctor->shape;
+    InstancePrototypeSlot *entry = NULL;
+    JSShapeProperty *desc;
+    JSProperty *prop;
+
+    if (ctx->rt->instance_mode == 2) {
+        entry = &ctx->rt->instance_slots[(site ^ (site >> 9)) & 63];
+        if (entry->site == site && entry->offset < (uint32_t)shape->prop_count) {
+            desc = &get_shape_prop(shape)[entry->offset];
+            if (desc->atom == JS_ATOM_prototype && !(desc->flags & JS_PROP_TMASK))
+                return &ctor->prop[entry->offset];
+        }
+    }
+    desc = find_own_property(&prop, ctor, JS_ATOM_prototype);
+    if (!desc || (desc->flags & JS_PROP_TMASK))
+        return NULL;
+    if (entry) {
+        entry->offset = (uint32_t)(prop - ctor->prop);
+        entry->site = site;
+    }
+    return prop;
+}
+
+static int instance_fast_result(JSContext *ctx, JSValueConst val, JSObject *ctor,
+                                JSValueConst method, uintptr_t site)
+{
+    if (!JS_IsObject(method) || ctor->class_id != JS_CLASS_BYTECODE_FUNCTION ||
+        ctx->rt->interrupt_handler || js_check_stack_overflow(ctx->rt, 4096))
+        return -1;
+    JSObject *hook = JS_VALUE_GET_OBJ(method);
+    if (hook->class_id != JS_CLASS_C_FUNCTION || hook->u.cfunc.realm != ctx ||
+        hook->u.cfunc.cproto != JS_CFUNC_generic || hook->u.cfunc.c_function.generic != js_function_hasInstance)
+        return -1;
+    if (!JS_IsObject(val))
+        return FALSE;
+    JSObject *lhs = JS_VALUE_GET_OBJ(val);
+    if (lhs->is_exotic)
+        return -1;
+    JSProperty *proto = instance_proto_property(ctx, ctor, site);
+    if (proto && JS_IsObject(proto->u.value) && lhs->shape->proto == JS_VALUE_GET_OBJ(proto->u.value))
+        return TRUE;
+    return -1;
+}
+
+static int js_instanceof_at(JSContext *ctx, JSValueConst val, JSValueConst obj, uintptr_t site)
