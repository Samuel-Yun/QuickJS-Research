+static int census_builtin(JSValueConst v, JSCFunction *fn) {
+    if (JS_VALUE_GET_TAG(v) != JS_TAG_OBJECT) return 0;
+    JSObject *p = JS_VALUE_GET_OBJ(v);
+    return p->class_id == JS_CLASS_C_FUNCTION && p->u.cfunc.cproto == JS_CFUNC_generic &&
+           p->u.cfunc.c_function.generic == fn;
+}
+JSValue round_census_toggle(JSContext *ctx, JSValueConst self, int argc, JSValueConst *argv) {
+    census_run = argc && JS_ToBool(ctx, argv[0]);
+    if (!census_run) fprintf(stderr,"ROUND,%llu,%llu,%llu,%llu,%llu,%llu,%llu,%llu\n",
+      (unsigned long long)census_instance_op,(unsigned long long)census_helper,(unsigned long long)census_default,
+      (unsigned long long)census_primitive,(unsigned long long)census_direct,(unsigned long long)census_call,
+      (unsigned long long)census_call_js,(unsigned long long)census_method_sites_call);
